#!/usr/bin/env python3
import sys, os, json, argparse, hashlib, datetime

RULES = [
    {
        "id": "CIS-AWS-3.0-2.1.1",
        "title": "S3 Buckets Must Enable Public Access Block",
        "severity": "CRITICAL",
        "provider": "aws",
        "resource_type": "aws-s3-bucket",
        "rql": "config from cloud.resource where cloud.type = 'aws' and api.name = 'aws-s3-bucket' and json.rule = publicAccessBlockConfiguration.restrictPublicBuckets is false",
        "description": "S3 buckets should prohibit public bucket policies and ACLs to prevent unauthorized global data exposure.",
        "framework_mappings": ["CIS AWS v3.0: 2.1.1", "SOC 2: CC6.1", "PCI-DSS v4.0: 1.2.1"],
        "check": lambda r: not r.get("state", {}).get("publicAccessBlockConfiguration", {}).get("restrictPublicBuckets", False),
        "remediation_hcl": """resource "aws_s3_bucket_public_access_block" "{{RESOURCE_ID}}_block" {
  bucket = aws_s3_bucket.{{RESOURCE_ID}}.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}"""
    },
    {
        "id": "CIS-AWS-3.0-2.2.1",
        "title": "RDS Instances Must Enable Storage Encryption",
        "severity": "HIGH",
        "provider": "aws",
        "resource_type": "aws-rds-instance",
        "rql": "config from cloud.resource where cloud.type = 'aws' and api.name = 'aws-rds-instance' and json.rule = storageEncrypted is false",
        "description": "Amazon RDS database instances should have storage encryption enabled with KMS keys.",
        "framework_mappings": ["CIS AWS v3.0: 2.2.1", "NIST 800-53: SC-28", "HIPAA: 164.312(a)(2)(iv)"],
        "check": lambda r: not r.get("state", {}).get("storageEncrypted", False),
        "remediation_hcl": """resource "aws_db_instance" "{{RESOURCE_ID}}" {
  storage_encrypted = true
  kms_key_id        = aws_kms_key.rds.arn
}"""
    },
    {
        "id": "CIS-AWS-3.0-4.1",
        "title": "Security Groups Must Not Permit Ingress From 0.0.0.0/0 to Port 22",
        "severity": "CRITICAL",
        "provider": "aws",
        "resource_type": "aws-security-group",
        "rql": "config from cloud.resource where cloud.type = 'aws' and api.name = 'aws-security-group' and json.rule = ipPermissions[].fromPort = 22 and json.rule = ipPermissions[].ipRanges[].cidrIp = '0.0.0.0/0'",
        "description": "Security groups must not allow open ingress to port 22 (SSH) from the public Internet.",
        "framework_mappings": ["CIS AWS v3.0: 4.1", "PCI-DSS v4.0: 1.3.1", "SOC 2: CC6.6"],
        "check": lambda r: any(
            p.get("fromPort") == 22 and any(rng.get("cidrIp") == "0.0.0.0/0" for rng in p.get("ipRanges", []))
            for p in r.get("state", {}).get("ipPermissions", [])
        ),
        "remediation_hcl": """resource "aws_security_group_rule" "restricted_ssh" {
  type              = "ingress"
  from_port         = 22
  to_port           = 22
  protocol          = "tcp"
  cidr_blocks       = ["10.0.0.0/8"]
  security_group_id = aws_security_group.{{RESOURCE_ID}}.id
}"""
    },
    {
        "id": "CIS-AZURE-2.1-1",
        "title": "Azure Storage Accounts Must Enforce HTTPS Secure Transfer",
        "severity": "HIGH",
        "provider": "azure",
        "resource_type": "azure-storage-account",
        "rql": "config from cloud.resource where cloud.type = 'azure' and api.name = 'azure-storage-account' and json.rule = properties.supportsHttpsTrafficOnly is false",
        "description": "Azure storage accounts should enforce secure transfer over HTTPS.",
        "framework_mappings": ["CIS Azure v2.1: 2.1", "PCI-DSS v4.0: 4.1.2"],
        "check": lambda r: not r.get("state", {}).get("properties", {}).get("supportsHttpsTrafficOnly", True),
        "remediation_hcl": """resource "azurerm_storage_account" "{{RESOURCE_ID}}" {
  enable_https_traffic_only = true
}"""
    },
    {
        "id": "CIS-GCP-2.0-3.1",
        "title": "Cloud Storage Buckets Must Enable Uniform Bucket-Level Access",
        "severity": "HIGH",
        "provider": "gcp",
        "resource_type": "gcp-storage-bucket",
        "rql": "config from cloud.resource where cloud.type = 'gcp' and api.name = 'gcp-storage-bucket' and json.rule = uniformBucketLevelAccess.enabled is false",
        "description": "Uniform bucket-level access unifies IAM permissions and disables per-object ACL vulnerabilities.",
        "framework_mappings": ["CIS GCP v2.0: 3.1", "SOC 2: CC6.3"],
        "check": lambda r: not r.get("state", {}).get("uniformBucketLevelAccess", {}).get("enabled", True),
        "remediation_hcl": """resource "google_storage_bucket" "{{RESOURCE_ID}}" {
  uniform_bucket_level_access = true
}"""
    }
]

def evaluate_inventory(inventory):
    findings = []
    for res in inventory:
        for rule in RULES:
            if res.get("provider") == rule["provider"] and res.get("resource_type") == rule["resource_type"]:
                if rule["check"](res):
                    state_hash = hashlib.sha256(json.dumps(res.get("state", {}), sort_keys=True).encode()).hexdigest()
                    hcl = rule["remediation_hcl"].replace("{{RESOURCE_ID}}", res.get("name", "target"))
                    findings.append({
                        "id": f"{rule['id']}-{res.get('id')}",
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "status": "FAIL",
                        "provider": res.get("provider"),
                        "account_id": res.get("account_id"),
                        "region": res.get("region"),
                        "resource_id": res.get("id"),
                        "resource_arn": res.get("arn"),
                        "resource_type": res.get("resource_type"),
                        "framework_mappings": rule["framework_mappings"],
                        "evidence": {
                            "rule_id": rule["id"],
                            "target_path": f"$.state (evaluated against RQL: {rule['rql']})",
                            "expected_value": "Compliant configuration",
                            "observed_value": "Violates security policy",
                            "message": rule["description"],
                            "resource_state_hash": state_hash
                        },
                        "remediation": {
                            "format": "terraform_hcl",
                            "code": hcl,
                            "sha256_hash": hashlib.sha256(hcl.encode()).hexdigest()
                        },
                        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat()
                    })
    return findings

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")
        
        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "posturesecure-mcp", "version": "0.1.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "posture_evaluate_compliance",
                            "description": "Evaluate multi-cloud inventory against standard CIS benchmarks",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"inventory_json": {"type": "string"}},
                                "required": ["inventory_json"]
                            }
                        },
                        {
                            "name": "posture_generate_remediation",
                            "description": "Generate Terraform HCL patch for a rule ID",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"rule_id": {"type": "string"}, "resource_name": {"type": "string"}},
                                "required": ["rule_id", "resource_name"]
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            if name == "posture_evaluate_compliance":
                raw_inv = args.get("inventory_json", "[]")
                try:
                    inv = json.loads(raw_inv)
                    findings = evaluate_inventory(inv)
                    tool_res = {"findings_count": len(findings), "findings": findings}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "posture_generate_remediation":
                rid = args.get("rule_id", "")
                rname = args.get("resource_name", "target")
                match = next((r for r in RULES if r["id"].lower() == rid.lower()), None)
                if match:
                    patch = match["remediation_hcl"].replace("{{RESOURCE_ID}}", rname)
                    tool_res = {"rule_id": match["id"], "terraform_patch": patch}
                else:
                    tool_res = {"error": f"Rule {rid} not found"}
            else:
                tool_res = {"error": f"Unknown tool: {name}"}
            
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
                }
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}
        
        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="PostureSecure CLI")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")
    
    scan_p = subparsers.add_parser("scan", help="Scan cloud inventory")
    scan_p.add_argument("--input", "-i", required=True, help="Path to cloud inventory JSON")
    scan_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")
    
    rem_p = subparsers.add_parser("remediate", help="Generate remediation")
    rem_p.add_argument("--rule", "-r", required=True, help="Rule ID")
    rem_p.add_argument("--resource-name", "-n", default="target", help="Resource Name")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "scan":
        with open(args.input, "r", encoding="utf-8") as f:
            inv = json.load(f)
        findings = evaluate_inventory(inv)
        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<22} {'RESOURCE':<28} {'TITLE'}")
            print("-" * 105)
            for f in findings:
                glyph = "[!]" if f["severity"] == "CRITICAL" else "[/!\\]"
                print(f"{glyph + ' ' + f['severity']:<10} {f['rule_id']:<22} {f['resource_id']:<28} {f['title']}")
            print("-" * 105)
            print(f"Total Findings: {len(findings)}")
        elif args.format == "json":
            print(json.dumps(findings, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "PostureSecure", "version": "0.1.0"}},
                    "results": [{
                        "ruleId": f["rule_id"],
                        "level": "error" if f["severity"] == "CRITICAL" else "warning",
                        "message": {"text": f["title"]}
                    } for f in findings]
                }]
            }
            print(json.dumps(sarif, indent=2))
    elif args.subcommand == "remediate":
        match = next((r for r in RULES if r["id"].lower() == args.rule.lower()), None)
        if match:
            patch = match["remediation_hcl"].replace("{{RESOURCE_ID}}", args.resource_name)
            print(f"# Remediation Patch for Rule {match['id']}\n{patch}")
        else:
            print(f"Unknown rule: {args.rule}", file=sys.stderr)
            sys.exit(1)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
