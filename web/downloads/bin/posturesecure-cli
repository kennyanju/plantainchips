SUPPRESSIONS = {}

def get_cloudsecure_dir():
    custom = os.environ.get("CLOUDSECURE_HOME")
    if custom:
        os.makedirs(custom, exist_ok=True)
        return custom
    home_dir = os.path.expanduser("~/.cloudsecure")
    try:
        os.makedirs(home_dir, exist_ok=True)
        with tempfile.NamedTemporaryFile(dir=home_dir, prefix=".writetest_", delete=True) as _:
            pass
        return home_dir
    except Exception:
        local_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".cloudsecure"))
        os.makedirs(local_dir, exist_ok=True)
        return local_dir

def get_suppressions_file():
    return os.path.join(get_cloudsecure_dir(), "posture_suppressions.json")

def load_suppressions():
    global SUPPRESSIONS
    supp_file = get_suppressions_file()
    if os.path.exists(supp_file):
        try:
            with open(supp_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    SUPPRESSIONS.update(data)
        except Exception:
            pass

def save_suppressions():
    try:
        supp_file = get_suppressions_file()
        os.makedirs(os.path.dirname(supp_file), exist_ok=True)
        with open(supp_file, "w", encoding="utf-8") as f:
            json.dump(SUPPRESSIONS, f, indent=2)
    except Exception:
        pass

def get_nested(obj, path):
    parts = path.split(".")
    curr = obj
    for p in parts:
        if isinstance(curr, dict):
            curr = curr.get(p)
        else:
            return None
    return curr

def evaluate_inventory(inventory, provider_filter=None, include_suppressed=False):
    findings = []
    for res in inventory:
        prov = res.get("provider", "").lower()
        if provider_filter and provider_filter.lower() != "all" and prov != provider_filter.lower():
            continue

        for rule in RULES:
            if prov == rule["provider"].lower() and res.get("resource_type") == rule["resource_type"]:
                if rule["check"](res):
                    fid = f"{rule['id']}-{res.get('id')}"
                    is_suppressed = fid in SUPPRESSIONS
                    if is_suppressed and not include_suppressed:
                        continue

                    state_hash = hashlib.sha256(json.dumps(res.get("state", {}), sort_keys=True).encode()).hexdigest()
                    hcl = rule["remediation_hcl"].replace("{{RESOURCE_ID}}", res.get("name", "target"))
                    cli = rule.get("remediation_cli", "").replace("{{RESOURCE_ID}}", res.get("name", "target"))
                    findings.append({
                        "id": fid,
                        "rule_id": rule["id"],
                        "title": rule["title"],
                        "severity": rule["severity"],
                        "status": "SUPPRESSED" if is_suppressed else "FAIL",
                        "suppression_reason": SUPPRESSIONS.get(fid) if is_suppressed else None,
                        "provider": res.get("provider"),
                        "account_id": res.get("account_id"),
                        "region": res.get("region"),
                        "resource_id": res.get("id"),
                        "resource_arn": res.get("arn"),
                        "resource_type": res.get("resource_type"),
                        "framework_mappings": rule["framework_mappings"],
                        "evidence": {
                            "rule_id": rule["id"],
                            "target_path": f"$.state (evaluated against RQL: {rule['rql']})",
                            "expected_value": "Compliant configuration",
                            "observed_value": "Violates security policy",
                            "message": rule["description"],
                            "resource_state_hash": state_hash
                        },
                        "remediation": {
                            "format": "terraform_hcl",
                            "code": hcl,
                            "cli_command": cli,
                            "sha256_hash": hashlib.sha256(hcl.encode()).hexdigest()
                        },
                        "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat()
                    })
    return findings

def evaluate_rql_query(inventory, query_str):
    # Basic RQL config evaluator for live filtering
    # e.g.: config from cloud.resource where cloud.type = 'aws' and api.name = 'aws-s3-bucket'
    where_match = re.search(r"where\s+(.*)", query_str, re.IGNORECASE)
    if not where_match:
        return inventory

    clauses_str = where_match.group(1).strip()
    clauses = [c.strip() for c in re.split(r"\s+and\s+", clauses_str, flags=re.IGNORECASE)]

    results = []
    for res in inventory:
        matched = True
        for clause in clauses:
            eq_m = re.match(r"^([\w\.]+)\s*=\s*['\"]?([^'\"]+)['\"]?$", clause)
            neq_m = re.match(r"^([\w\.]+)\s*!=\s*['\"]?([^'\"]+)['\"]?$", clause)
            is_false_m = re.match(r"^([\w\.]+)\s+is\s+false$", clause, re.IGNORECASE)
            is_true_m = re.match(r"^([\w\.]+)\s+is\s+true$", clause, re.IGNORECASE)

            if eq_m:
                field, val = eq_m.group(1), eq_m.group(2)
                f_val = str(get_nested(res, field) or "")
                if field == "cloud.type":
                    f_val = res.get("provider", "")
                elif field == "api.name":
                    f_val = res.get("resource_type", "")
                if f_val.lower() != val.lower():
                    matched = False
                    break
            elif neq_m:
                field, val = neq_m.group(1), neq_m.group(2)
                f_val = str(get_nested(res, field) or "")
                if field == "cloud.type":
                    f_val = res.get("provider", "")
                elif field == "api.name":
                    f_val = res.get("resource_type", "")
                if f_val.lower() == val.lower():
                    matched = False
                    break
            elif is_false_m:
                field = is_false_m.group(1)
                f_val = get_nested(res.get("state", {}), field)
                if f_val is not False:
                    matched = False
                    break
            elif is_true_m:
                field = is_true_m.group(1)
                f_val = get_nested(res.get("state", {}), field)
                if f_val is not True:
                    matched = False
                    break

        if matched:
            results.append(res)
    return results

def detect_drift(baseline_inventory, current_inventory):
    base_map = {r["id"]: r for r in baseline_inventory}
    drift_records = []

    for curr in current_inventory:
        rid = curr.get("id")
        base = base_map.get(rid)
        if not base:
            continue

        base_hash = hashlib.sha256(json.dumps(base.get("state", {}), sort_keys=True).encode()).hexdigest()
        curr_hash = hashlib.sha256(json.dumps(curr.get("state", {}), sort_keys=True).encode()).hexdigest()

        if base_hash != curr_hash:
            diffs = []
            b_state = base.get("state", {})
            c_state = curr.get("state", {})
            for k, c_val in c_state.items():
                b_val = b_state.get(k)
                if b_val != c_val:
                    diffs.append({
                        "attribute": f"state.{k}",
                        "baseline_value": b_val,
                        "current_value": c_val
                    })
            drift_records.append({
                "resource_id": rid,
                "resource_arn": curr.get("arn"),
                "baseline_hash": base_hash,
                "current_hash": curr_hash,
                "attribute_diffs": diffs
            })

    return drift_records

def suppress_finding(finding_id, reason="Approved exception", persist=False):
    SUPPRESSIONS[finding_id] = reason
    if persist:
        save_suppressions()
    return {"status": "suppressed", "finding_id": finding_id, "reason": reason}

def run_mcp():
    load_suppressions()
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if req_id is None:
            # JSON-RPC / MCP notifications do not have an ID and must not receive a response
            continue

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "posturesecure-mcp", "version": "0.2.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "posture_evaluate_compliance",
                            "description": "Evaluate multi-cloud inventory against standard CIS benchmarks",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "inventory_json": {"type": "string"},
                                    "provider": {"type": "string"},
                                    "include_suppressed": {"type": "boolean"}
                                },
                                "required": ["inventory_json"]
                            }
                        },
                        {
                            "name": "posture_query_rql",
                            "description": "Execute ad-hoc RQL config query against cloud inventory",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "query": {"type": "string"},
                                    "inventory_json": {"type": "string"}
                                },
                                "required": ["query", "inventory_json"]
                            }
                        },
                        {
                            "name": "posture_detect_drift",
                            "description": "Detect attribute-level configuration drift between baseline and current cloud states",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "baseline_json": {"type": "string"},
                                    "current_json": {"type": "string"}
                                },
                                "required": ["baseline_json", "current_json"]
                            }
                        },
                        {
                            "name": "posture_suppress_finding",
                            "description": "Suppress a specific CSPM finding with documented business justification",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "finding_id": {"type": "string"},
                                    "reason": {"type": "string"}
                                },
                                "required": ["finding_id", "reason"]
                            }
                        },
                        {
                            "name": "posture_generate_remediation",
                            "description": "Generate Terraform HCL patch and Cloud CLI commands for a rule ID",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"rule_id": {"type": "string"}, "resource_name": {"type": "string"}},
                                "required": ["rule_id", "resource_name"]
                            }
                        },
                        {
                            "name": "posture_list_rules",
                            "description": "List all active multi-cloud CSPM rules in standard policy pack",
                            "inputSchema": {"type": "object", "properties": {}}
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            if name == "posture_evaluate_compliance":
                raw_inv = args.get("inventory_json", "[]")
                prov = args.get("provider")
                inc_sup = args.get("include_suppressed", False)
                try:
                    inv = json.loads(raw_inv)
                    findings = evaluate_inventory(inv, provider_filter=prov, include_suppressed=inc_sup)
                    tool_res = {"findings_count": len(findings), "findings": findings}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "posture_query_rql":
                q = args.get("query", "")
                raw_inv = args.get("inventory_json", "[]")
                try:
                    inv = json.loads(raw_inv)
                    matched = evaluate_rql_query(inv, q)
                    tool_res = {"query": q, "matched_count": len(matched), "resources": matched}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "posture_detect_drift":
                b_raw = args.get("baseline_json", "[]")
                c_raw = args.get("current_json", "[]")
                try:
                    b_inv = json.loads(b_raw)
                    c_inv = json.loads(c_raw)
                    drift = detect_drift(b_inv, c_inv)
                    tool_res = {"drift_count": len(drift), "drift_records": drift}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "posture_suppress_finding":
                fid = args.get("finding_id", "")
                reason = args.get("reason", "Approved exception")
                tool_res = suppress_finding(fid, reason, persist=True)
            elif name == "posture_generate_remediation":
                rid = args.get("rule_id", "")
                rname = args.get("resource_name", "target")
                match = next((r for r in RULES if r["id"].lower() == rid.lower()), None)
                if match:
                    patch = match["remediation_hcl"].replace("{{RESOURCE_ID}}", rname)
                    cli = match.get("remediation_cli", "").replace("{{RESOURCE_ID}}", rname)
                    tool_res = {
                        "rule_id": match["id"],
                        "terraform_patch": patch,
                        "cli_command": cli
                    }
                else:
                    tool_res = {"error": f"Rule {rid} not found"}
            elif name == "posture_list_rules":
                rule_summaries = [
                    {
                        "id": r["id"],
                        "title": r["title"],
                        "severity": r["severity"],
                        "provider": r["provider"],
                        "resource_type": r["resource_type"],
                        "framework_mappings": r["framework_mappings"]
                    }
                    for r in RULES
                ]
                tool_res = {"total_rules": len(RULES), "rules": rule_summaries}
            else:
                tool_res = {"error": f"Unknown tool: {name}"}

            call_result = {
                "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
            }
            if isinstance(tool_res, dict) and "error" in tool_res:
                call_result["isError"] = True
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": call_result
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="PostureSecure CLI: Multi-Cloud CSPM Engine")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    scan_p = subparsers.add_parser("scan", help="Scan cloud inventory against CIS benchmarks")
    scan_p.add_argument("--input", "-i", required=True, help="Path to cloud inventory JSON")
    scan_p.add_argument("--provider", "-p", choices=["aws", "azure", "gcp", "k8s", "all"], default="all")
    scan_p.add_argument("--include-suppressed", action="store_true", help="Include suppressed findings")
    scan_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")

    rql_p = subparsers.add_parser("rql", help="Execute ad-hoc RQL config query against cloud inventory")
    rql_p.add_argument("--query", "-q", required=True, help="RQL query string")
    rql_p.add_argument("--input", "-i", required=True, help="Path to cloud inventory JSON")

    drift_p = subparsers.add_parser("drift", help="Detect configuration drift between baseline and current")
    drift_p.add_argument("--baseline", "-b", required=True, help="Baseline inventory JSON")
    drift_p.add_argument("--current", "-c", required=True, help="Current inventory JSON")

    suppress_p = subparsers.add_parser("suppress", help="Suppress a finding ID with documented reason")
    suppress_p.add_argument("--finding-id", required=True, help="Finding ID to suppress")
    suppress_p.add_argument("--reason", required=True, help="Business justification reason")

    rem_p = subparsers.add_parser("remediate", help="Generate remediation code (Terraform HCL and CLI)")
    rem_p.add_argument("--rule", "-r", required=True, help="Rule ID")
    rem_p.add_argument("--resource-name", "-n", default="target", help="Resource Name")

    subparsers.add_parser("rules", help="List all available CSPM rules")

    args = parser.parse_args()
    load_suppressions()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "scan":
        with open(args.input, "r", encoding="utf-8") as f:
            inv = json.load(f)
        findings = evaluate_inventory(inv, provider_filter=args.provider, include_suppressed=args.include_suppressed)
        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<22} {'PROVIDER':<10} {'RESOURCE':<28} {'TITLE'}")
            print("-" * 115)
            for f in findings:
                glyph = "[!]" if f["severity"] == "CRITICAL" else "[*]"
                status_suffix = " (SUPPRESSED)" if f.get("status") == "SUPPRESSED" else ""
                print(f"{glyph + ' ' + f['severity']:<10} {f['rule_id']:<22} {f['provider']:<10} {f['resource_id']:<28} {f['title']}{status_suffix}")
            print("-" * 115)
            print(f"Total Findings: {len(findings)} (Provider filter: {args.provider})")
        elif args.format == "json":
            print(json.dumps(findings, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "PostureSecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": f["rule_id"],
                        "level": "error" if f["severity"] == "CRITICAL" else "warning",
                        "message": {"text": f["title"]}
                    } for f in findings]
                }]
            }
            print(json.dumps(sarif, indent=2))

    elif args.subcommand == "rql":
        with open(args.input, "r", encoding="utf-8") as f:
            inv = json.load(f)
        matched = evaluate_rql_query(inv, args.query)
        print(f"RQL Query: {args.query}")
        print(f"Matched Resources ({len(matched)}):")
        for r in matched:
            print(f"  - [{r.get('provider')}] {r.get('id')} ({r.get('resource_type')}) - {r.get('name')}")

    elif args.subcommand == "drift":
        with open(args.baseline, "r", encoding="utf-8") as f:
            b_inv = json.load(f)
        with open(args.current, "r", encoding="utf-8") as f:
            c_inv = json.load(f)
        diffs = detect_drift(b_inv, c_inv)
        print(f"Configuration Drift Detection ({len(diffs)} resources drifted):")
        for d in diffs:
            print(f"\nResource: {d['resource_id']} ({d['resource_arn']})")
            print(f"  Baseline Hash: {d['baseline_hash'][:12]}... -> Current Hash: {d['current_hash'][:12]}...")
            for attr in d["attribute_diffs"]:
                print(f"  Attribute: {attr['attribute']}: {attr['baseline_value']} => {attr['current_value']}")

    elif args.subcommand == "suppress":
        res = suppress_finding(args.finding_id, args.reason, persist=True)
        print(f"[SUCCESS] Suppressed finding '{res['finding_id']}' with reason: {res['reason']}")

    elif args.subcommand == "remediate":
        match = next((r for r in RULES if r["id"].lower() == args.rule.lower()), None)
        if match:
            patch = match["remediation_hcl"].replace("{{RESOURCE_ID}}", args.resource_name)
            cli = match.get("remediation_cli", "").replace("{{RESOURCE_ID}}", args.resource_name)
            print(f"# Terraform Remediation for Rule {match['id']}:\n{patch}\n")
            print(f"# Cloud CLI Command:\n{cli}")
        else:
            print(f"Unknown rule: {args.rule}", file=sys.stderr)
            sys.exit(1)

    elif args.subcommand == "rules":
        print(f"{'RULE ID':<22} {'SEVERITY':<10} {'PROVIDER':<10} {'RESOURCE TYPE':<26} {'TITLE'}")
        print("-" * 115)
        for r in RULES:
            print(f"{r['id']:<22} {r['severity']:<10} {r['provider']:<10} {r['resource_type']:<26} {r['title']}")
        print("-" * 115)
        print(f"Total Rules in Catalog: {len(RULES)}")

    else:
        parser.print_help()

if __name__ == "__main__":
    main()
