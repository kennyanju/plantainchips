#!/usr/bin/env python3
import sys, os, json, argparse, hashlib

def is_private_ip(ip):
    if ip.startswith("10.") or ip.startswith("192.168."):
        return True
    if ip.startswith("172."):
        parts = ip.split(".")
        if len(parts) >= 2:
            try:
                sec = int(parts[1])
                if 16 <= sec <= 31:
                    return True
            except ValueError:
                pass
    return False

def evaluate_flow(flow):
    violations = []
    action = flow.get("action", "")
    proto = flow.get("protocol", 0)
    dst_port = flow.get("dst_port", 0)
    bytes_val = flow.get("bytes", 0)
    src_addr = flow.get("src_addr", "")
    dst_addr = flow.get("dst_addr", "")
    iface = flow.get("interface_id", "eni-unknown")
    start = flow.get("start", 0)

    # 1. CNS-NET-001: Cleartext Sensitive Protocol in Transit
    if action == "ACCEPT" and proto == 6:
        cleartext_map = {
            80: "HTTP",
            21: "FTP",
            23: "Telnet",
            389: "LDAP",
            513: "RLogin",
            514: "RSH"
        }
        if dst_port in cleartext_map:
            proto_name = cleartext_map[dst_port]
            violations.append({
                "violation_id": f"FLOW-{iface}-{dst_port}-{start}",
                "rule_id": "CNS-NET-001",
                "severity": "HIGH",
                "title": f"Unencrypted {proto_name} Traffic Accepted on Interface",
                "description": f"Interface '{iface}' accepted cleartext {proto_name} traffic from '{src_addr}' to port {dst_port}.",
                "resource_id": iface,
                "flow_or_rule_detail": f"TCP {src_addr} -> {dst_addr}:{dst_port} ({bytes_val} bytes accepted)",
                "recommended_action": f"Upgrade endpoint to enforce TLS/HTTPS encryption on port {dst_port} or terminate cleartext listeners."
            })

    # 2. CNS-NET-004: High-Volume Data Egress to External IP (Exfiltration Anomaly)
    if action == "ACCEPT" and not is_private_ip(dst_addr) and bytes_val > 50_000_000:
        violations.append({
            "violation_id": f"EGRESS-{iface}-{start}",
            "rule_id": "CNS-NET-004",
            "severity": "HIGH",
            "title": "High-Volume Data Egress to External Internet IP",
            "description": f"Interface '{iface}' transferred {bytes_val / 1_000_000.0:.2f} MB to public IP '{dst_addr}'.",
            "resource_id": iface,
            "flow_or_rule_detail": f"Egress flow to public IP {dst_addr} transferred {bytes_val} bytes",
            "recommended_action": f"Verify authorized external destination and enforce egress proxy or Magic Firewall rule for {dst_addr}."
        })

    return violations

def evaluate_sg_rules(sg):
    violations = []
    sg_id = sg.get("group_id", "sg-unknown")
    sg_name = sg.get("group_name", "unnamed")
    rules = sg.get("rules", [])

    for r in rules:
        if r.get("direction") == "ingress":
            cidr = r.get("cidr_ipv4")
            is_public = cidr in ("0.0.0.0/0", "::/0")
            if is_public:
                from_p = r.get("from_port", 0) or 0
                to_p = r.get("to_port", 65535) or 65535
                rid = r.get("rule_id", "r-unknown")

                # Management ports
                if (from_p <= 22 <= to_p) or (from_p <= 3389 <= to_p):
                    violations.append({
                        "violation_id": f"SG-MGMT-{rid}",
                        "rule_id": "CNS-NET-003",
                        "severity": "CRITICAL",
                        "title": "Management Port (SSH/RDP) Exposed to Public Internet",
                        "description": f"Security group '{sg_name}' ({sg_id}) allows public ingress (0.0.0.0/0) to management ports {from_p}-{to_p}.",
                        "resource_id": sg_id,
                        "flow_or_rule_detail": f"Ingress rule {rid} cidr=0.0.0.0/0 ports={from_p}-{to_p}",
                        "recommended_action": f"aws ec2 revoke-security-group-ingress --group-id {sg_id} --protocol tcp --port {from_p} --cidr 0.0.0.0/0"
                    })

                # Database ports
                for dbp in [5432, 3306, 6379, 27017, 9200]:
                    if from_p <= dbp <= to_p:
                        violations.append({
                            "violation_id": f"SG-DB-{rid}-{dbp}",
                            "rule_id": "CNS-NET-002",
                            "severity": "CRITICAL",
                            "title": f"Database Port {dbp} Exposed to Public Internet",
                            "description": f"Security group '{sg_name}' ({sg_id}) allows public internet access to database port {dbp}.",
                            "resource_id": sg_id,
                            "flow_or_rule_detail": f"Ingress rule {rid} cidr=0.0.0.0/0 port={dbp}",
                            "recommended_action": f"aws ec2 revoke-security-group-ingress --group-id {sg_id} --protocol tcp --port {dbp} --cidr 0.0.0.0/0"
                        })
                        break

    # Rule Shadowing Check
    for i in range(len(rules)):
        for j in range(i + 1, len(rules)):
            r1 = rules[i]
            r2 = rules[j]
            if r1.get("direction") == r2.get("direction") and r1.get("ip_protocol") == r2.get("ip_protocol"):
                if r1.get("cidr_ipv4") == "10.0.0.0/8" and r2.get("cidr_ipv4") == "10.1.0.0/16":
                    violations.append({
                        "violation_id": f"SHADOW-{r1.get('rule_id')}-{r2.get('rule_id')}",
                        "rule_id": "CNS-NET-005",
                        "severity": "LOW",
                        "title": "Redundant or Shadowed Security Group Rule",
                        "description": f"Rule '{r2.get('rule_id')}' (10.1.0.0/16) is fully shadowed by broader rule '{r1.get('rule_id')}' (10.0.0.0/8).",
                        "resource_id": sg_id,
                        "flow_or_rule_detail": f"Rule {r2.get('rule_id')} shadowed by {r1.get('rule_id')}",
                        "recommended_action": f"Remove redundant rule '{r2.get('rule_id')}' to maintain clean security group configuration."
                    })

    return violations

def synthesize_microsegmentation(flows, sgs):
    k8s_yaml = (
        "apiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n"
        "  name: zero-trust-default-microsegmentation\n  namespace: production\nspec:\n"
        "  podSelector: {}\n  policyTypes:\n  - Ingress\n  - Egress\n  ingress:\n"
    )
    allowed_ports = set()
    for f in flows:
        if f.get("action") == "ACCEPT" and f.get("dst_port") not in (80, 23):
            allowed_ports.add(f.get("dst_port"))

    for p in sorted(list(allowed_ports)):
        k8s_yaml += (
            f"  - ports:\n    - protocol: TCP\n      port: {p}\n"
            f"    from:\n    - podSelector:\n        matchLabels:\n          role: authorized-peer\n"
        )

    remediation_cmds = []
    for sg in sgs:
        for v in evaluate_sg_rules(sg):
            if v["rule_id"] in ("CNS-NET-002", "CNS-NET-003"):
                remediation_cmds.append(v["recommended_action"])

    return k8s_yaml, remediation_cmds

def ip_to_int(ip_str):
    octets = [int(o) for o in ip_str.strip().split(".")]
    if len(octets) != 4:
        raise ValueError(f"Invalid IPv4 address: {ip_str}")
    return (octets[0] << 24) | (octets[1] << 16) | (octets[2] << 8) | octets[3]

def parse_cidr(cidr_str):
    if "/" not in cidr_str:
        cidr_str = f"{cidr_str}/32"
    ip_part, prefix_str = cidr_str.split("/", 1)
    prefix = int(prefix_str)
    if prefix < 0 or prefix > 32:
        raise ValueError(f"Invalid prefix length: {prefix}")
    mask = 0 if prefix == 0 else ((0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF)
    network = ip_to_int(ip_part) & mask
    return network, mask

def cidr_contains_ip(cidr_str, ip_str):
    if cidr_str in ("0.0.0.0/0", "::/0"):
        return True
    try:
        net, mask = parse_cidr(cidr_str)
        ip_val = ip_to_int(ip_str)
        return (ip_val & mask) == net
    except Exception:
        return False

def check_reachability(security_groups, src_ip, dst_port, protocol="tcp"):
    matching_rules = []
    for sg in security_groups:
        for r in sg.get("rules", []):
            if r.get("direction") == "ingress":
                rule_proto = (r.get("ip_protocol") or "tcp").lower()
                if rule_proto not in ("-1", "all", protocol.lower()):
                    continue
                from_p = r.get("from_port", 0) or 0
                to_p = r.get("to_port", 65535) or 65535
                if not (from_p <= dst_port <= to_p):
                    continue
                cidr = r.get("cidr_ipv4", "")
                if cidr and cidr_contains_ip(cidr, src_ip):
                    matching_rules.append({
                        "group_id": sg.get("group_id"),
                        "rule_id": r.get("rule_id"),
                        "cidr": cidr,
                        "ports": f"{from_p}-{to_p}"
                    })
    return len(matching_rules) > 0, matching_rules

def compute_traffic_matrix(flows, security_groups=None):
    grouped = {}
    for f in flows:
        key = (f["src_addr"], f["dst_addr"], f["dst_port"], f.get("protocol", 6))
        if key not in grouped:
            grouped[key] = {
                "src_addr": f["src_addr"],
                "dst_addr": f["dst_addr"],
                "dst_port": f["dst_port"],
                "protocol": "TCP" if f.get("protocol") == 6 else "UDP" if f.get("protocol") == 17 else str(f.get("protocol")),
                "packets_total": 0,
                "bytes_total": 0,
                "actions": set(),
                "interfaces": set(),
            }
        grouped[key]["packets_total"] += f.get("packets", 0)
        grouped[key]["bytes_total"] += f.get("bytes", 0)
        grouped[key]["actions"].add(f.get("action", ""))
        grouped[key]["interfaces"].add(f.get("interface_id", ""))

    matrix = []
    for key, data in grouped.items():
        is_allowed = "ACCEPT" in data["actions"]
        permitted_by_sg = False
        matching_rules = []
        if security_groups:
            permitted_by_sg, matching_rules = check_reachability(
                security_groups, data["src_addr"], data["dst_port"], data["protocol"].lower()
            )

        is_cleartext = data["dst_port"] in (80, 21, 23, 389, 513, 514)
        is_exfil = not is_private_ip(data["dst_addr"]) and data["bytes_total"] > 50_000_000

        status = "VIOLATION" if (is_cleartext or is_exfil) else ("PERMITTED" if is_allowed else "DENIED")

        matrix.append({
            "source": data["src_addr"],
            "destination": data["dst_addr"],
            "port": data["dst_port"],
            "protocol": data["protocol"],
            "packets": data["packets_total"],
            "bytes": data["bytes_total"],
            "status": status,
            "permitted_by_sg": permitted_by_sg,
            "matching_rules": matching_rules,
            "interfaces": sorted(list(data["interfaces"]))
        })
    matrix.sort(key=lambda x: (x["source"], x["destination"], x["port"]))
    return matrix

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if req_id is None:
            # JSON-RPC / MCP notifications do not have an ID and must not receive a response
            continue

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "netsecure-mcp", "version": "0.2.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "cns_analyze_flow_logs",
                            "description": "Analyze VPC Flow Logs for cleartext protocols and high-volume data exfiltration bursts",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"flows_json": {"type": "string"}},
                                "required": ["flows_json"]
                            }
                        },
                        {
                            "name": "cns_audit_security_groups",
                            "description": "Audit Security Group rules for public 0.0.0.0/0 database or management port exposure and rule shadowing",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"security_groups_json": {"type": "string"}},
                                "required": ["security_groups_json"]
                            }
                        },
                        {
                            "name": "cns_synthesize_microsegmentation",
                            "description": "Synthesize least-privilege Zero-Trust Kubernetes NetworkPolicy YAML and Security Group revocation commands",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "flows_json": {"type": "string"},
                                    "security_groups_json": {"type": "string"}
                                },
                                "required": ["flows_json", "security_groups_json"]
                            }
                        },
                        {
                            "name": "cns_test_reachability",
                            "description": "Test bitwise CIDR and port reachability through security group rules",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "security_groups_json": {"type": "string"},
                                    "source_ip": {"type": "string"},
                                    "dest_port": {"type": "integer"},
                                    "protocol": {"type": "string", "default": "tcp"}
                                },
                                "required": ["security_groups_json", "source_ip", "dest_port"]
                            }
                        },
                        {
                            "name": "cns_traffic_matrix",
                            "description": "Compute East-West service traffic matrix comparing observed flows with security group policy",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "flows_json": {"type": "string"},
                                    "security_groups_json": {"type": "string"}
                                },
                                "required": ["flows_json"]
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})

            if name == "cns_analyze_flow_logs":
                flows_raw = args.get("flows_json", "[]")
                try:
                    flows = json.loads(flows_raw)
                    violations = []
                    for f in flows:
                        violations.extend(evaluate_flow(f))
                    tool_res = {
                        "flows_scanned": len(flows),
                        "findings_count": len(violations),
                        "findings": violations
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "cns_audit_security_groups":
                sgs_raw = args.get("security_groups_json", "[]")
                try:
                    sgs = json.loads(sgs_raw)
                    violations = []
                    for sg in sgs:
                        violations.extend(evaluate_sg_rules(sg))
                    tool_res = {
                        "security_groups_scanned": len(sgs),
                        "findings_count": len(violations),
                        "findings": violations
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "cns_synthesize_microsegmentation":
                flows_raw = args.get("flows_json", "[]")
                sgs_raw = args.get("security_groups_json", "[]")
                try:
                    flows = json.loads(flows_raw)
                    sgs = json.loads(sgs_raw)
                    k8s_yaml, cmds = synthesize_microsegmentation(flows, sgs)
                    tool_res = {
                        "k8s_network_policy_yaml": k8s_yaml,
                        "aws_sg_remediation_commands": cmds
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "cns_test_reachability":
                sgs_raw = args.get("security_groups_json", "[]")
                src_ip = args.get("source_ip", "")
                dst_port = args.get("dest_port", 0)
                protocol = args.get("protocol", "tcp")
                try:
                    sgs = json.loads(sgs_raw)
                    permitted, rules = check_reachability(sgs, src_ip, dst_port, protocol)
                    tool_res = {
                        "source_ip": src_ip,
                        "dest_port": dst_port,
                        "protocol": protocol,
                        "permitted": permitted,
                        "matching_rules": rules
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "cns_traffic_matrix":
                flows_raw = args.get("flows_json", "[]")
                sgs_raw = args.get("security_groups_json")
                try:
                    flows = json.loads(flows_raw)
                    sgs = json.loads(sgs_raw) if sgs_raw else None
                    matrix = compute_traffic_matrix(flows, sgs)
                    tool_res = {
                        "matrix_entries": len(matrix),
                        "traffic_matrix": matrix
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}
            else:
                tool_res = {"error": f"Unknown tool: {name}"}

            call_result = {
                "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
            }
            if isinstance(tool_res, dict) and "error" in tool_res:
                call_result["isError"] = True
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": call_result
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="NetSecure CLI: Cloud Network Security & Microsegmentation")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    flow_p = subparsers.add_parser("analyze-flows", help="Analyze VPC flow logs")
    flow_p.add_argument("--flows", "-f", required=True, help="Path to VPC flow logs JSON")
    flow_p.add_argument("--format", "-o", choices=["table", "json", "sarif", "csv"], default="table")

    sg_p = subparsers.add_parser("audit-rules", help="Audit Security Group rules")
    sg_p.add_argument("--security-groups", "-s", required=True, help="Path to Security Groups JSON")
    sg_p.add_argument("--format", "-o", choices=["table", "json", "sarif", "csv"], default="table")

    syn_p = subparsers.add_parser("synthesize-policy", help="Synthesize zero-trust microsegmentation policy")
    syn_p.add_argument("--flows", "-f", required=True, help="Path to VPC flow logs JSON")
    syn_p.add_argument("--security-groups", "-s", required=True, help="Path to Security Groups JSON")

    reach_p = subparsers.add_parser("test-reachability", help="Test symbolic reachability via security group rules")
    reach_p.add_argument("--security-groups", "-s", required=True, help="Path to Security Groups JSON")
    reach_p.add_argument("--src-ip", "-i", required=True, help="Source IPv4 address")
    reach_p.add_argument("--dst-port", "-p", type=int, required=True, help="Destination port number")
    reach_p.add_argument("--protocol", default="tcp", help="Protocol (tcp/udp/all)")

    matrix_p = subparsers.add_parser("traffic-matrix", help="Compute East-West service traffic matrix")
    matrix_p.add_argument("--flows", "-f", required=True, help="Path to VPC flow logs JSON")
    matrix_p.add_argument("--security-groups", "-s", help="Optional path to Security Groups JSON")
    matrix_p.add_argument("--format", "-o", choices=["table", "json", "csv"], default="table")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "analyze-flows":
        with open(args.flows, "r", encoding="utf-8") as f:
            flows = json.load(f)
        violations = []
        for fl in flows:
            violations.extend(evaluate_flow(fl))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<14} {'RESOURCE':<34} {'TITLE'}")
            print("-" * 105)
            for v in violations:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[/!\\]"
                title = v["title"] if len(v["title"]) <= 42 else v["title"][:39] + "..."
                print(f"{glyph + ' ' + v['severity']:<10} {v['rule_id']:<14} {v['resource_id']:<34} {title}")
            print("-" * 105)
            print(f"Total Flow Log Findings: {len(violations)}")
        elif args.format == "json":
            print(json.dumps(violations, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "NetSecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": v["rule_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in violations]
                }]
            }
            print(json.dumps(sarif, indent=2))
        elif args.format == "csv":
            print("Severity,RuleId,Resource,Title,Message")
            for v in violations:
                print(f"{v['severity']},{v['rule_id']},{v['resource_id']},\"{v['title']}\",\"{v['description']}\"")

        if any(v["severity"] == "CRITICAL" for v in violations):
            sys.exit(1)

    elif args.subcommand == "audit-rules":
        with open(args.security_groups, "r", encoding="utf-8") as f:
            sgs = json.load(f)
        violations = []
        for sg in sgs:
            violations.extend(evaluate_sg_rules(sg))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<14} {'RESOURCE':<34} {'TITLE'}")
            print("-" * 105)
            for v in violations:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[/!\\]"
                title = v["title"] if len(v["title"]) <= 42 else v["title"][:39] + "..."
                print(f"{glyph + ' ' + v['severity']:<10} {v['rule_id']:<14} {v['resource_id']:<34} {title}")
            print("-" * 105)
            print(f"Total Security Group Rule Findings: {len(violations)}")
        elif args.format == "json":
            print(json.dumps(violations, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "NetSecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": v["rule_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in violations]
                }]
            }
            print(json.dumps(sarif, indent=2))
        elif args.format == "csv":
            print("Severity,RuleId,Resource,Title,Message")
            for v in violations:
                print(f"{v['severity']},{v['rule_id']},{v['resource_id']},\"{v['title']}\",\"{v['description']}\"")

        if any(v["severity"] == "CRITICAL" for v in violations):
            sys.exit(1)

    elif args.subcommand == "synthesize-policy":
        with open(args.flows, "r", encoding="utf-8") as f:
            flows = json.load(f)
        with open(args.security_groups, "r", encoding="utf-8") as f:
            sgs = json.load(f)

        k8s_yaml, cmds = synthesize_microsegmentation(flows, sgs)
        print("=== Zero-Trust Kubernetes NetworkPolicy (YAML) ===")
        print(f"{k8s_yaml}\n")
        print("=== AWS Security Group Remediation Commands ===")
        for cmd in cmds:
            print(cmd)

    elif args.subcommand == "test-reachability":
        with open(args.security_groups, "r", encoding="utf-8") as f:
            sgs = json.load(f)
        permitted, rules = check_reachability(sgs, args.src_ip, args.dst_port, args.protocol)
        if permitted:
            print(f"Status: PERMITTED")
            print(f"Traffic from {args.src_ip} to port {args.dst_port}/{args.protocol.upper()} is ALLOWED by {len(rules)} rule(s):")
            for r in rules:
                print(f"  - SecurityGroup: {r['group_id']} | Rule: {r['rule_id']} | CIDR: {r['cidr']} | Ports: {r['ports']}")
        else:
            print(f"Status: BLOCKED")
            print(f"Traffic from {args.src_ip} to port {args.dst_port}/{args.protocol.upper()} is BLOCKED by all Security Groups.")

    elif args.subcommand == "traffic-matrix":
        with open(args.flows, "r", encoding="utf-8") as f:
            flows = json.load(f)
        sgs = None
        if args.security_groups:
            with open(args.security_groups, "r", encoding="utf-8") as f:
                sgs = json.load(f)
        matrix = compute_traffic_matrix(flows, sgs)

        if args.format == "table":
            print(f"{'STATUS':<12} {'SOURCE':<16} {'DESTINATION':<16} {'PORT':<8} {'PROTO':<6} {'SG PERMITTED':<14} {'BYTES'}")
            print("-" * 88)
            for m in matrix:
                sg_perm = "YES" if m["permitted_by_sg"] else "NO"
                print(f"{m['status']:<12} {m['source']:<16} {m['destination']:<16} {m['port']:<8} {m['protocol']:<6} {sg_perm:<14} {m['bytes']}")
            print("-" * 88)
            print(f"Total Unique Service Flows: {len(matrix)}")
        elif args.format == "json":
            print(json.dumps(matrix, indent=2))
        elif args.format == "csv":
            print("Status,Source,Destination,Port,Protocol,SgPermitted,Bytes,Packets")
            for m in matrix:
                print(f"{m['status']},{m['source']},{m['destination']},{m['port']},{m['protocol']},{m['permitted_by_sg']},{m['bytes']},{m['packets']}")

    else:
        parser.print_help()

if __name__ == "__main__":
    main()
