def scan_image(image):
    findings = []
    layers = image.get("layers", [])
    for layer in layers:
        l_idx = layer.get("layer_index", 0)
        # Check secrets leaked in layers
        for s in layer.get("secrets_leaked", []):
            findings.append({
                "type": "SECRET_LEAK",
                "cve_id": "LAYER-SECRET-001",
                "package_name": "hardcoded_secret",
                "installed_version": "embedded",
                "fixed_version": "Remove from Dockerfile RUN layer",
                "severity": "CRITICAL",
                "cvss_score": 9.5,
                "epss_score": 0.90,
                "introduced_in_layer_index": l_idx,
                "title": "Hardcoded Secret Token Leaked in Image Layer",
                "description": f"Sensitive secret token '{s[:4]}-****' was written into layer {l_idx} history."
            })

        for pkg in layer.get("packages", []):
            p_name = pkg.get("name")
            p_ver = pkg.get("version", "")
            for rule in KNOWN_VULNS:
                if rule["package_name"] == p_name and rule["match_version"](p_ver):
                    findings.append({
                        "type": "VULNERABILITY",
                        "cve_id": rule["cve_id"],
                        "package_name": p_name,
                        "installed_version": p_ver,
                        "fixed_version": rule["fixed_version"],
                        "severity": rule["severity"],
                        "cvss_score": rule["cvss"],
                        "epss_score": rule.get("epss", 0.0),
                        "cisa_kev": rule.get("cisa_kev", False),
                        "introduced_in_layer_index": l_idx,
                        "title": rule["title"],
                        "description": rule["description"]
                    })
    return findings

def audit_pod_security(pod_spec):
    violations = []
    spec = pod_spec.get("spec", pod_spec)

    # 1. Host namespace sharing
    if spec.get("hostNetwork", False):
        violations.append({
            "rule_id": "PSS-HOST-NETWORK",
            "severity": "HIGH",
            "title": "Pod Enables Host Network Namespace",
            "description": "Pod shares the host network namespace, bypassing network security boundaries."
        })
    if spec.get("hostPID", False):
        violations.append({
            "rule_id": "PSS-HOST-PID",
            "severity": "HIGH",
            "title": "Pod Enables Host Process ID Namespace",
            "description": "Pod shares host PID namespace, exposing all host processes to container inspection."
        })

    # 2. Container level audits
    containers = spec.get("containers", [])
    for c in containers:
        c_name = c.get("name", "container")
        sc = c.get("securityContext", {})
        if sc.get("privileged", False):
            violations.append({
                "rule_id": "PSS-PRIVILEGED",
                "container_name": c_name,
                "severity": "CRITICAL",
                "title": "Container Running in Privileged Mode",
                "description": f"Container '{c_name}' has privileged=true, granting direct access to all host devices."
            })
        if sc.get("runAsUser") == 0 or sc.get("runAsNonRoot") is False:
            violations.append({
                "rule_id": "PSS-ROOT-USER",
                "container_name": c_name,
                "severity": "HIGH",
                "title": "Container Executing as Root UID 0",
                "description": f"Container '{c_name}' does not enforce runAsNonRoot."
            })
        if not sc.get("readOnlyRootFilesystem", False):
            violations.append({
                "rule_id": "PSS-WRITABLE-ROOTFS",
                "container_name": c_name,
                "severity": "MEDIUM",
                "title": "Missing Read-Only Root Filesystem",
                "description": f"Container '{c_name}' has a writable root filesystem."
            })
        caps = sc.get("capabilities", {}).get("add", [])
        if "CAP_SYS_ADMIN" in caps or "SYS_ADMIN" in caps:
            violations.append({
                "rule_id": "PSS-DANGEROUS-CAP",
                "container_name": c_name,
                "severity": "CRITICAL",
                "title": "Dangerous Capability CAP_SYS_ADMIN Granted",
                "description": f"Container '{c_name}' requested CAP_SYS_ADMIN, nearly equivalent to root breakout."
            })

    # 3. Volume mounts check for docker.sock
    for v in spec.get("volumes", []):
        hp = v.get("hostPath", {}).get("path", "")
        if "docker.sock" in hp:
            violations.append({
                "rule_id": "PSS-DOCKER-SOCK-MOUNT",
                "severity": "CRITICAL",
                "title": "Docker Socket Mounted from Host",
                "description": f"Volume '{v.get('name')}' mounts '{hp}', enabling complete host takeover."
            })

    return violations

def evaluate_runtime_event(ev):
    anomalies = []
    proc = ev.get("process_executable", "")
    args = " ".join(ev.get("process_args", []))
    parent = ev.get("parent_process", "")
    syscall = ev.get("syscall", "")
    cid = ev.get("container_id", "container")

    # Rule 1: Shell spawned by daemon
    if (proc.endswith("/sh") or proc.endswith("/bash") or proc.endswith("/zsh")) and any(d in parent for d in ["nginx", "node", "python", "gunicorn"]):
        anomalies.append({
            "anomaly_id": f"ANOM-{ev.get('event_id')}",
            "rule_id": "CWPP-RT-001",
            "severity": "CRITICAL",
            "title": "Unexpected Shell Spawned by Daemon Process",
            "description": f"Production daemon '{parent}' spawned interactive shell '{proc}' inside container '{cid}'. Potential RCE.",
            "container_id": cid
        })

    # Rule 2: Root container process
    if ev.get("is_root", False) and ev.get("user_id", 1000) == 0:
        anomalies.append({
            "anomaly_id": f"ANOM-ROOT-{ev.get('event_id')}",
            "rule_id": "CWPP-RT-002",
            "severity": "HIGH",
            "title": "Container Process Running as Root UID 0",
            "description": f"Process '{proc}' is executing with root UID 0 inside container '{cid}'.",
            "container_id": cid
        })

    # Rule 3: Escape syscall
    if syscall in ["ptrace", "reboot", "setns", "unshare", "mount"]:
        anomalies.append({
            "anomaly_id": f"ANOM-SYS-{ev.get('event_id')}",
            "rule_id": "CWPP-RT-003",
            "severity": "CRITICAL",
            "title": "Dangerous Container Escape Syscall Invocation",
            "description": f"Process '{proc}' invoked restricted syscall '{syscall}' inside container '{cid}'.",
            "container_id": cid
        })

    # Rule 4: Cryptomining activity
    if any(m in proc or m in args for m in ["xmrig", "minerd", "stratum+tcp", "hashvault"]):
        anomalies.append({
            "anomaly_id": f"ANOM-MINER-{ev.get('event_id')}",
            "rule_id": "CWPP-RT-004",
            "severity": "CRITICAL",
            "title": "Cryptomining Process or Pool Connection Detected",
            "description": f"Cryptominer execution '{proc}' ({args}) observed in container '{cid}'.",
            "container_id": cid
        })

    # Rule 5: Sensitive system file access
    if any(f in args for f in ["/etc/shadow", "/proc/kcore", "serviceaccount/token"]):
        anomalies.append({
            "anomaly_id": f"ANOM-FILE-{ev.get('event_id')}",
            "rule_id": "CWPP-RT-005",
            "severity": "HIGH",
            "title": "Unauthorized Access to Sensitive Credential Files",
            "description": f"Process '{proc}' attempted access to sensitive host/k8s credential files: '{args}'.",
            "container_id": cid
        })

    return anomalies

def synthesize_hardening_yaml(container_name):
    return f"""# Hardened Kubernetes SecurityContext for {container_name}
securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  runAsNonRoot: true
  runAsUser: 10001
  capabilities:
    drop:
      - ALL
    add:
      - NET_BIND_SERVICE
  seccompProfile:
    type: RuntimeDefault"""

def synthesize_seccomp_profile():
    return {
        "defaultAction": "SCMP_ACT_ERRNO",
        "architectures": ["SCMP_ARCH_X86_64", "SCMP_ARCH_AARCH64"],
        "syscalls": [
            {
                "names": [
                    "accept4", "bind", "clone", "close", "epoll_create1", "epoll_ctl",
                    "epoll_pwait", "exit_group", "futex", "getpid", "getuid", "listen",
                    "nanosleep", "read", "recvfrom", "rt_sigaction", "rt_sigprocmask",
                    "sendto", "socket", "write"
                ],
                "action": "SCMP_ACT_ALLOW"
            }
        ]
    }

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if req_id is None:
            # JSON-RPC / MCP notifications do not have an ID and must not receive a response
            continue

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "workloadsecure-mcp", "version": "0.1.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "workload_scan_image",
                            "description": "Inspect OCI container image layers and match against 15+ CVEs with layer attribution",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"image_json": {"type": "string"}},
                                "required": ["image_json"]
                            }
                        },
                        {
                            "name": "workload_audit_pod_security",
                            "description": "Audit Kubernetes Pod spec against Pod Security Standards",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"pod_json": {"type": "string"}},
                                "required": ["pod_json"]
                            }
                        },
                        {
                            "name": "workload_evaluate_runtime_event",
                            "description": "Evaluate container eBPF runtime events against Falco behavioral detection rules",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"event_json": {"type": "string"}},
                                "required": ["event_json"]
                            }
                        },
                        {
                            "name": "workload_synthesize_hardening",
                            "description": "Generate hardened Kubernetes SecurityContext and Linux Seccomp profile",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"container_name": {"type": "string"}},
                                "required": ["container_name"]
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            if name == "workload_scan_image":
                raw_json = args.get("image_json", "{}")
                try:
                    img = json.loads(raw_json)
                    vulns = scan_image(img)
                    tool_res = {"vulnerabilities_count": len(vulns), "vulnerabilities": vulns}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "workload_audit_pod_security":
                raw_json = args.get("pod_json", "{}")
                try:
                    pod = json.loads(raw_json)
                    violations = audit_pod_security(pod)
                    tool_res = {"violations_count": len(violations), "violations": violations}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "workload_evaluate_runtime_event":
                raw_json = args.get("event_json", "{}")
                try:
                    ev = json.loads(raw_json)
                    anomalies = evaluate_runtime_event(ev)
                    tool_res = {"anomalies_count": len(anomalies), "anomalies": anomalies}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "workload_synthesize_hardening":
                cname = args.get("container_name", "app")
                tool_res = {
                    "kubernetes_security_context": synthesize_hardening_yaml(cname),
                    "linux_seccomp_profile": synthesize_seccomp_profile()
                }
            else:
                tool_res = {"error": f"Unknown tool: {name}"}

            call_result = {
                "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
            }
            if isinstance(tool_res, dict) and "error" in tool_res:
                call_result["isError"] = True
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": call_result
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="WorkloadSecure CLI: CWPP Container Image & Runtime Engine")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    scan_p = subparsers.add_parser("scan", help="Scan container image manifest for CVEs and layer secrets")
    scan_p.add_argument("--input", "-i", required=True, help="Path to container image JSON")
    scan_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")

    pod_p = subparsers.add_parser("pod-audit", help="Audit Kubernetes Pod security spec")
    pod_p.add_argument("--input", "-i", required=True, help="Path to pod spec JSON")

    runtime_p = subparsers.add_parser("runtime", help="Analyze runtime event stream for anomalies")
    runtime_p.add_argument("--input", "-i", required=True, help="Path to runtime events JSON")

    harden_p = subparsers.add_parser("harden", help="Generate Kubernetes SecurityContext and Seccomp profiles")
    harden_p.add_argument("--name", "-n", default="workload", help="Container or workload name")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "scan":
        with open(args.input, "r", encoding="utf-8") as f:
            data = json.load(f)
        images = data if isinstance(data, list) else [data]
        all_vulns = []
        for img in images:
            vulns = scan_image(img)
            all_vulns.extend(vulns)

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'CVE ID':<18} {'PACKAGE':<18} {'LAYER':<8} {'TITLE'}")
            print("-" * 105)
            for v in all_vulns:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[*]"
                print(f"{glyph + ' ' + v['severity']:<10} {v['cve_id']:<18} {v['package_name']:<18} {str(v['introduced_in_layer_index']):<8} {v['title']}")
            print("-" * 105)
            print(f"Total Findings: {len(all_vulns)}")
        elif args.format == "json":
            print(json.dumps(all_vulns, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "WorkloadSecure", "version": "0.1.0"}},
                    "results": [{
                        "ruleId": v["cve_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in all_vulns]
                }]
            }
            print(json.dumps(sarif, indent=2))

    elif args.subcommand == "pod-audit":
        with open(args.input, "r", encoding="utf-8") as f:
            pod_data = json.load(f)
        violations = audit_pod_security(pod_data)
        print(f"Pod Security Violations ({len(violations)}):")
        for v in violations:
            print(f"  [{v['severity']}] {v['rule_id']}: {v['title']} - {v['description']}")

    elif args.subcommand == "runtime":
        with open(args.input, "r", encoding="utf-8") as f:
            events = json.load(f)
        ev_list = events if isinstance(events, list) else [events]
        anomalies = []
        for ev in ev_list:
            anomalies.extend(evaluate_runtime_event(ev))
        print(f"Runtime Behavioral Anomalies ({len(anomalies)}):")
        for a in anomalies:
            print(f"  [{a['severity']}] {a['rule_id']}: {a['title']} (Container: {a['container_id']})")

    elif args.subcommand == "harden":
        yaml_out = synthesize_hardening_yaml(args.name)
        seccomp_out = synthesize_seccomp_profile()
        print(f"--- Hardened Kubernetes SecurityContext ---\n{yaml_out}\n")
        print(f"--- Linux Seccomp Profile JSON ---\n{json.dumps(seccomp_out, indent=2)}")

    else:
        parser.print_help()

if __name__ == "__main__":
    main()
