#!/usr/bin/env python3
import sys, os, json, argparse, hashlib

def damerau_levenshtein_distance(a, b):
    m = len(a)
    n = len(b)
    if m == 0:
        return n
    if n == 0:
        return m

    dp = [[0] * (n + 1) for _ in range(m + 1)]
    for i in range(m + 1):
        dp[i][0] = i
    for j in range(n + 1):
        dp[0][j] = j

    for i in range(1, m + 1):
        for j in range(1, n + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            dp[i][j] = min(
                dp[i - 1][j] + 1,
                dp[i][j - 1] + 1,
                dp[i - 1][j - 1] + cost
            )
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                dp[i][j] = min(dp[i][j], dp[i - 2][j - 2] + 1)

    return dp[m][n]

def evaluate_provenance(prov):
    violations = []
    builder_id = prov.get("builder_id", "")
    is_hermetic = prov.get("is_hermetic", False)
    is_isolated = prov.get("is_isolated", False)
    commit_sha = prov.get("source_commit_sha", "")
    subjects = prov.get("subject", [])
    artifact_name = subjects[0].get("name", "artifact") if subjects else "artifact"

    # SLSA Level Calculation
    level = 2
    if is_hermetic and is_isolated:
        if ("slsa-framework/slsa-github-generator" in builder_id or "tekton" in builder_id or "google/cloud-build" in builder_id) and (len(commit_sha) in (40, 64)):
            level = 3

    if level < 3:
        violations.append({
            "id": f"SLSA-LVL3-{artifact_name.replace('/', '-')}",
            "rule_id": "SLSA-001",
            "severity": "HIGH",
            "title": "Artifact Fails SLSA Level 3 Build Provenance Requirements",
            "description": f"Artifact '{artifact_name}' achieved SLSA Level {level}, but policy requires SLSA Level 3 with hermetic ephemeral build isolation.",
            "resource_id": artifact_name,
            "evidence_detail": f"Calculated SLSA Level {level} (hermetic={is_hermetic}, isolated={is_isolated})",
            "remediation_action": "Migrate build pipeline to SLSA Level 3 delegator generator with ephemeral hosted runners."
        })

    if len(commit_sha) < 40:
        violations.append({
            "id": f"SLSA-PIN-{artifact_name.replace('/', '-')}",
            "rule_id": "SLSA-002",
            "severity": "HIGH",
            "title": "Build Provenance Relies on Mutable Tag Reference",
            "description": f"Source commit '{commit_sha}' for artifact '{artifact_name}' is a mutable reference instead of a full 40-character SHA1 commit hash.",
            "resource_id": artifact_name,
            "evidence_detail": f"source_commit_sha='{commit_sha}' is not a 40/64 character hex digest",
            "remediation_action": "Pin build triggers to immutable git commit SHA hashes rather than mutable branch/tag references."
        })

    return violations

def evaluate_signature(sig):
    violations = []
    uri = sig.get("artifact_uri", "unknown-image")
    is_signed = sig.get("is_signed", False)
    rekor = sig.get("rekor_log_entry")
    digest = sig.get("digest", "")

    if not is_signed:
        violations.append({
            "id": f"COSIGN-UNSIGNED-{uri.replace('/', '-')}",
            "rule_id": "COSIGN-001",
            "severity": "CRITICAL",
            "title": "Container Image Artifact Unsigned",
            "description": f"Container image '{uri}' ({digest}) lacks a verified Cosign cryptographic signature.",
            "resource_id": uri,
            "evidence_detail": "is_signed=false",
            "remediation_action": f"cosign sign --key k8s://cosign-keys/signing-key {uri}"
        })
    elif rekor is None:
        violations.append({
            "id": f"COSIGN-NOREKOR-{uri.replace('/', '-')}",
            "rule_id": "COSIGN-002",
            "severity": "HIGH",
            "title": "Signature Lacks Sigstore Rekor Transparency Log Entry",
            "description": f"Image '{uri}' has signature but lacks non-repudiation proof in Rekor public transparency log.",
            "resource_id": uri,
            "evidence_detail": "rekor_log_entry=null",
            "remediation_action": "Sign image with keyless Sigstore workflow to guarantee public transparency log inclusion."
        })

    return violations

def evaluate_dependency(dep):
    violations = []
    name = dep.get("name", "")
    is_internal = dep.get("is_internal_scope", False)
    on_public = dep.get("found_on_public_registry", False)
    reg = dep.get("registry", "npm")

    if is_internal and on_public:
        violations.append({
            "id": f"DEP-CONF-{name.replace('/', '-')}",
            "rule_id": "DEP-CONF-001",
            "severity": "CRITICAL",
            "title": "Dependency Confusion Vulnerability on Internal Scoped Package",
            "description": f"Internal package '{name}' was detected on public registry '{reg}'. Adversary can publish higher version to achieve remote code execution.",
            "resource_id": name,
            "evidence_detail": f"is_internal_scope=true and found_on_public_registry=true for '{name}'",
            "remediation_action": f"Claim and reserve package '{name}' on public {reg} registry or enforce scoped registry configuration."
        })

    popular_targets = ["lodash", "lodash-es", "requests", "express", "react", "axios", "chalk", "urllib3"]
    for target in popular_targets:
        dist = damerau_levenshtein_distance(name, target)
        if dist == 1 and name != target:
            violations.append({
                "id": f"TYPO-{name}-{target}",
                "rule_id": "TYPO-SQUAT-001",
                "severity": "HIGH",
                "title": f"Potential Typo-Squatting Package Mimicking '{target}'",
                "description": f"Package '{name}' has an edit distance of 1 from popular package '{target}', indicating a high risk of typo-squatting malware.",
                "resource_id": name,
                "evidence_detail": f"damerau_levenshtein_distance({name}, {target}) == 1",
                "remediation_action": f"Audit and replace suspicious package '{name}' with legitimate library '{target}'."
            })

    return violations

def synthesize_admission_policy():
    return (
        "apiVersion: kyverno.io/v1\n"
        "kind: ClusterPolicy\n"
        "metadata:\n"
        "  name: enforce-cosign-and-slsa-level3\n"
        "  annotations:\n"
        "    policies.kyverno.io/title: Verify Image Signatures and SLSA Provenance\n"
        "    policies.kyverno.io/category: Software Supply Chain Security\n"
        "spec:\n"
        "  validationFailureAction: Enforce\n"
        "  background: false\n"
        "  rules:\n"
        "  - name: verify-cosign-signature\n"
        "    match:\n"
        "      any:\n"
        "      - resources:\n"
        "          kinds:\n"
        "          - Pod\n"
        "    verifyImages:\n"
        "    - imageReferences:\n"
        "      - \"registry.internal.net/*\"\n"
        "      attestors:\n"
        "      - entries:\n"
        "        - keyless:\n"
        "            issuer: \"https://token.actions.githubusercontent.com\"\n"
        "            subject: \"https://github.com/my-org/*\"\n"
        "  - name: verify-slsa-level3-attestation\n"
        "    match:\n"
        "      any:\n"
        "      - resources:\n"
        "          kinds:\n"
        "          - Pod\n"
        "    verifyImages:\n"
        "    - imageReferences:\n"
        "      - \"registry.internal.net/*\"\n"
        "      attestations:\n"
        "      - predicateType: \"https://slsa.dev/provenance/v1\"\n"
        "        conditions:\n"
        "        - all:\n"
        "          - key: \"{{ builder.id }}\"\n"
        "            operator: Equals\n"
        "            value: \"https://github.com/slsa-framework/slsa-github-generator/*\"\n"
    )

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "supplysecure-mcp", "version": "0.1.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "sscs_verify_slsa_provenance",
                            "description": "Verify in-toto / SLSA v1.0 build provenance and verify Level 3 builder isolation",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"provenance_json": {"type": "string"}},
                                "required": ["provenance_json"]
                            }
                        },
                        {
                            "name": "sscs_verify_cosign_signatures",
                            "description": "Verify Cosign container image cryptographic signatures and Rekor transparency log proofs",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"signatures_json": {"type": "string"}},
                                "required": ["signatures_json"]
                            }
                        },
                        {
                            "name": "sscs_scan_dependencies",
                            "description": "Scan software package dependencies for dependency confusion and typo-squatting risks",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"manifest_json": {"type": "string"}},
                                "required": ["manifest_json"]
                            }
                        },
                        {
                            "name": "sscs_synthesize_admission_policy",
                            "description": "Synthesize Kubernetes Kyverno ClusterPolicy YAML enforcing image signatures and SLSA provenance",
                            "inputSchema": {
                                "type": "object",
                                "properties": {}
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})

            if name == "sscs_verify_slsa_provenance":
                raw = args.get("provenance_json", "[]")
                try:
                    records = json.loads(raw)
                    violations = []
                    for r in records:
                        violations.extend(evaluate_provenance(r))
                    tool_res = {
                        "provenance_records_scanned": len(records),
                        "findings_count": len(violations),
                        "findings": violations
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "sscs_verify_cosign_signatures":
                raw = args.get("signatures_json", "[]")
                try:
                    records = json.loads(raw)
                    violations = []
                    for r in records:
                        violations.extend(evaluate_signature(r))
                    tool_res = {
                        "signatures_scanned": len(records),
                        "findings_count": len(violations),
                        "findings": violations
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "sscs_scan_dependencies":
                raw = args.get("manifest_json", "[]")
                try:
                    records = json.loads(raw)
                    violations = []
                    for r in records:
                        violations.extend(evaluate_dependency(r))
                    tool_res = {
                        "dependencies_scanned": len(records),
                        "findings_count": len(violations),
                        "findings": violations
                    }
                except Exception as e:
                    tool_res = {"error": str(e)}

            elif name == "sscs_synthesize_admission_policy":
                tool_res = {
                    "kyverno_cluster_policy_yaml": synthesize_admission_policy()
                }
            else:
                tool_res = {"error": f"Unknown tool: {name}"}

            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
                }
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="SupplySecure CLI: Software Supply Chain Security Engine")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    slsa_p = subparsers.add_parser("verify-slsa", help="Verify SLSA v1.0 provenance")
    slsa_p.add_argument("--provenance", "-p", required=True, help="Path to SLSA provenance records JSON")
    slsa_p.add_argument("--format", "-o", choices=["table", "json", "sarif", "csv"], default="table")

    cosign_p = subparsers.add_parser("verify-signature", help="Verify Cosign image signatures")
    cosign_p.add_argument("--signatures", "-s", required=True, help="Path to Cosign signatures JSON")
    cosign_p.add_argument("--format", "-o", choices=["table", "json", "sarif", "csv"], default="table")

    dep_p = subparsers.add_parser("scan-dependencies", help="Scan dependencies for confusion and typos")
    dep_p.add_argument("--manifest", "-m", required=True, help="Path to dependency manifest JSON")
    dep_p.add_argument("--format", "-o", choices=["table", "json", "sarif", "csv"], default="table")

    subparsers.add_parser("synthesize-admission", help="Synthesize Kyverno admission controller policy")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "verify-slsa":
        with open(args.provenance, "r", encoding="utf-8") as f:
            records = json.load(f)
        violations = []
        for r in records:
            violations.extend(evaluate_provenance(r))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<16} {'RESOURCE':<32} {'TITLE'}")
            print("-" * 105)
            for v in violations:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[/!\\]"
                title = v["title"] if len(v["title"]) <= 42 else v["title"][:39] + "..."
                print(f"{glyph + ' ' + v['severity']:<10} {v['rule_id']:<16} {v['resource_id']:<32} {title}")
            print("-" * 105)
            print(f"Total SLSA Provenance Findings: {len(violations)}")
        elif args.format == "json":
            print(json.dumps(violations, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "SupplySecure", "version": "0.1.0"}},
                    "results": [{
                        "ruleId": v["rule_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in violations]
                }]
            }
            print(json.dumps(sarif, indent=2))
        elif args.format == "csv":
            print("Severity,RuleId,Resource,Title,Message")
            for v in violations:
                print(f"{v['severity']},{v['rule_id']},{v['resource_id']},\"{v['title']}\",\"{v['description']}\"")

        if any(v["severity"] == "CRITICAL" for v in violations):
            sys.exit(1)

    elif args.subcommand == "verify-signature":
        with open(args.signatures, "r", encoding="utf-8") as f:
            records = json.load(f)
        violations = []
        for r in records:
            violations.extend(evaluate_signature(r))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<16} {'RESOURCE':<32} {'TITLE'}")
            print("-" * 105)
            for v in violations:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[/!\\]"
                title = v["title"] if len(v["title"]) <= 42 else v["title"][:39] + "..."
                print(f"{glyph + ' ' + v['severity']:<10} {v['rule_id']:<16} {v['resource_id']:<32} {title}")
            print("-" * 105)
            print(f"Total Signature Verification Findings: {len(violations)}")
        elif args.format == "json":
            print(json.dumps(violations, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "SupplySecure", "version": "0.1.0"}},
                    "results": [{
                        "ruleId": v["rule_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in violations]
                }]
            }
            print(json.dumps(sarif, indent=2))
        elif args.format == "csv":
            print("Severity,RuleId,Resource,Title,Message")
            for v in violations:
                print(f"{v['severity']},{v['rule_id']},{v['resource_id']},\"{v['title']}\",\"{v['description']}\"")

        if any(v["severity"] == "CRITICAL" for v in violations):
            sys.exit(1)

    elif args.subcommand == "scan-dependencies":
        with open(args.manifest, "r", encoding="utf-8") as f:
            records = json.load(f)
        violations = []
        for r in records:
            violations.extend(evaluate_dependency(r))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<16} {'RESOURCE':<32} {'TITLE'}")
            print("-" * 105)
            for v in violations:
                glyph = "[!]" if v["severity"] == "CRITICAL" else "[/!\\]"
                title = v["title"] if len(v["title"]) <= 42 else v["title"][:39] + "..."
                print(f"{glyph + ' ' + v['severity']:<10} {v['rule_id']:<16} {v['resource_id']:<32} {title}")
            print("-" * 105)
            print(f"Total Dependency Audit Findings: {len(violations)}")
        elif args.format == "json":
            print(json.dumps(violations, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "SupplySecure", "version": "0.1.0"}},
                    "results": [{
                        "ruleId": v["rule_id"],
                        "level": "error" if v["severity"] == "CRITICAL" else "warning",
                        "message": {"text": v["title"]}
                    } for v in violations]
                }]
            }
            print(json.dumps(sarif, indent=2))
        elif args.format == "csv":
            print("Severity,RuleId,Resource,Title,Message")
            for v in violations:
                print(f"{v['severity']},{v['rule_id']},{v['resource_id']},\"{v['title']}\",\"{v['description']}\"")

        if any(v["severity"] == "CRITICAL" for v in violations):
            sys.exit(1)

    elif args.subcommand == "synthesize-admission":
        yaml = synthesize_admission_policy()
        print("=== Kubernetes Kyverno ClusterPolicy (YAML) ===")
        print(yaml)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
