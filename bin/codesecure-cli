#!/usr/bin/env python3
import sys, os, json, argparse, datetime, re, hashlib

def scan_file(file_obj):
    path = file_obj.get("path", "")
    ftype = file_obj.get("file_type", "").lower()
    content = file_obj.get("content", "")
    lines = content.splitlines()
    findings = []

    # 1. Hardcoded Secrets Check (Across all formats)
    for idx, line in enumerate(lines):
        # AWS Key
        if re.search(r'\b(AKIA|ASIA)[0-9A-Z]{16}\b', line):
            findings.append({
                "rule_id": "IAC_SEC_001",
                "file_path": path,
                "line_number": idx + 1,
                "severity": "CRITICAL",
                "title": "Hardcoded AWS Access Key ID",
                "message": "Hardcoded plaintext AWS access key committed directly to version control.",
                "auto_fix_patch": "# Replace plaintext key with environment variable or secret manager reference"
            })
        # GitHub PAT
        if re.search(r'\b(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{82})\b', line):
            findings.append({
                "rule_id": "IAC_SEC_002",
                "file_path": path,
                "line_number": idx + 1,
                "severity": "CRITICAL",
                "title": "Hardcoded GitHub Personal Access Token",
                "message": "Hardcoded GitHub PAT token committed directly to repository.",
                "auto_fix_patch": "# Replace PAT with ${{ secrets.GITHUB_TOKEN }} or repository secret"
            })
        # Private Key
        if "-----BEGIN PRIVATE KEY-----" in line or "-----BEGIN RSA PRIVATE KEY-----" in line:
            findings.append({
                "rule_id": "IAC_SEC_003",
                "file_path": path,
                "line_number": idx + 1,
                "severity": "CRITICAL",
                "title": "Hardcoded Cryptographic Private Key Block",
                "message": "Plaintext private key block committed directly to version control.",
                "auto_fix_patch": "# Remove private key and mount via Kubernetes secret or KMS"
            })

    # 2. Terraform HCL Rules
    if ftype in ("terraform-hcl", "terraform") or path.endswith((".tf", ".tf.json")):
        for idx, line in enumerate(lines):
            # S3 Public Read ACL
            if "acl" in line and "public-read" in line:
                findings.append({
                    "rule_id": "IAC_AWS_001",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "S3 Bucket Configured With Public-Read ACL",
                    "message": "S3 buckets should prohibit public read ACLs to prevent data leakage.",
                    "auto_fix_patch": line.replace("public-read", "private")
                })
            # Unencrypted RDS
            if "storage_encrypted" in line and "false" in line:
                findings.append({
                    "rule_id": "IAC_AWS_004",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "HIGH",
                    "title": "RDS Database Storage Encryption Disabled",
                    "message": "RDS storage_encrypted must be set to true.",
                    "auto_fix_patch": line.replace("false", "true")
                })
            # Publicly Accessible RDS
            if "publicly_accessible" in line and "true" in line:
                findings.append({
                    "rule_id": "IAC_AWS_005",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "RDS Database Configured As Publicly Accessible",
                    "message": "Databases must not be accessible directly from public IP addresses.",
                    "auto_fix_patch": line.replace("true", "false")
                })
            # Wildcard IAM Admin Policy
            if '"Action": "*"' in line and '"Resource": "*"' in content:
                findings.append({
                    "rule_id": "IAC_AWS_008",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "IAM Policy Grants Wildcard AdministratorAccess",
                    "message": "IAM policies must not grant Action:* and Resource:*.",
                    "auto_fix_patch": 'Action = ["s3:GetObject"] # Scope to specific required actions'
                })

        # Security Group SSH 0.0.0.0/0
        in_ingress = False
        has_22 = False
        ingress_start = 0
        for idx, line in enumerate(lines):
            if "ingress {" in line or 'type = "ingress"' in line:
                in_ingress = True
                ingress_start = idx + 1
            if in_ingress and ("22" in line or "from_port = 22" in line):
                has_22 = True
            if in_ingress and "0.0.0.0/0" in line and has_22:
                findings.append({
                    "rule_id": "IAC_AWS_002",
                    "file_path": path,
                    "line_number": ingress_start,
                    "severity": "CRITICAL",
                    "title": "Security Group Exposes SSH Port 22 to 0.0.0.0/0",
                    "message": "SSH must not be open to the entire public Internet.",
                    "auto_fix_patch": 'cidr_blocks = ["10.0.0.0/8"] # Restrict to internal CIDR'
                })
                in_ingress = False
                has_22 = False

    # 3. Kubernetes YAML Rules
    elif ftype in ("kubernetes-yaml", "kubernetes") or path.endswith((".yaml", ".yml")) and "apiVersion" in content:
        for idx, line in enumerate(lines):
            if "privileged: true" in line:
                findings.append({
                    "rule_id": "IAC_K8S_001",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "Kubernetes Container Runs in Privileged Mode",
                    "message": "Privileged containers can easily escape to host kernel namespace.",
                    "auto_fix_patch": line.replace("true", "false")
                })
            if "allowPrivilegeEscalation: true" in line:
                findings.append({
                    "rule_id": "IAC_K8S_003",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "HIGH",
                    "title": "Container Allows Privilege Escalation",
                    "message": "Set allowPrivilegeEscalation to false to prevent setuid breakouts.",
                    "auto_fix_patch": line.replace("true", "false")
                })
            if "hostNetwork: true" in line:
                findings.append({
                    "rule_id": "IAC_K8S_005",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "HIGH",
                    "title": "Pod Uses Host Network Namespace",
                    "message": "Pod shares the host network namespace.",
                    "auto_fix_patch": line.replace("true", "false")
                })

        if "securityContext:" in content and "readOnlyRootFilesystem: true" not in content:
            findings.append({
                "rule_id": "IAC_K8S_002",
                "file_path": path,
                "line_number": 1,
                "severity": "HIGH",
                "title": "Container Root Filesystem Is Writable",
                "message": "Enforce immutable containers by setting readOnlyRootFilesystem to true.",
                "auto_fix_patch": "      readOnlyRootFilesystem: true"
            })

    # 4. Dockerfile Rules
    elif ftype in ("dockerfile", "docker") or "Dockerfile" in path:
        if "USER " not in content:
            findings.append({
                "rule_id": "IAC_DOCKER_001",
                "file_path": path,
                "line_number": len(lines),
                "severity": "HIGH",
                "title": "Dockerfile Lacks Non-Root USER Directive",
                "message": "Container executes by default under root UID 0.",
                "auto_fix_patch": "USER 10001:10001"
            })
        for idx, line in enumerate(lines):
            stripped = line.strip()
            if stripped.startswith("FROM ") and (stripped.endswith(":latest") or ":" not in stripped):
                findings.append({
                    "rule_id": "IAC_DOCKER_002",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "MEDIUM",
                    "title": "Base Image Uses Unpinned :latest Tag",
                    "message": "Pin base images to explicit version tags or sha256 digests.",
                    "auto_fix_patch": line.replace(":latest", "@sha256:d83d...pin")
                })
            if "curl " in line and "| sh" in line or "wget " in line and "| sh" in line:
                findings.append({
                    "rule_id": "IAC_DOCKER_003",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "Remote Script Piped Directly into Shell",
                    "message": "Piping unverified remote scripts to shell creates arbitrary code execution vulnerabilities.",
                    "auto_fix_patch": "# Download, verify sha256 checksum, then execute"
                })
            if stripped.startswith("EXPOSE ") and "22" in stripped.split():
                findings.append({
                    "rule_id": "IAC_DOCKER_005",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "HIGH",
                    "title": "Dockerfile Exposes SSH Port 22",
                    "message": "Containers should not run SSH daemons; use kubectl exec or container tooling.",
                    "auto_fix_patch": "# Remove EXPOSE 22 and SSH daemon installation"
                })

    # 5. GitHub Actions YAML Rules
    elif ftype in ("github-actions-yaml", "gha", "github-actions") or ".github/workflows" in path:
        for idx, line in enumerate(lines):
            # Unpinned action
            if "uses:" in line and ("@master" in line or "@main" in line or "@v" not in line and "@" not in line):
                findings.append({
                    "rule_id": "IAC_GHA_001",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "HIGH",
                    "title": "Unpinned Third-Party GitHub Action",
                    "message": "Pin GitHub Actions to full 40-character commit SHAs instead of mutable branch tags.",
                    "auto_fix_patch": line.split("@")[0] + "@d63108...40charSHA"
                })
            # pull_request_target
            if "pull_request_target" in line:
                findings.append({
                    "rule_id": "IAC_GHA_002",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "Insecure pull_request_target Trigger in Workflow",
                    "message": "pull_request_target grants repository write tokens to untrusted fork PRs.",
                    "auto_fix_patch": line.replace("pull_request_target", "pull_request")
                })
            # write-all permissions
            if "permissions: write-all" in line:
                findings.append({
                    "rule_id": "IAC_GHA_003",
                    "file_path": path,
                    "line_number": idx + 1,
                    "severity": "CRITICAL",
                    "title": "Overpermissive GITHUB_TOKEN permissions: write-all",
                    "message": "Workflows should specify least-privilege permissions instead of write-all.",
                    "auto_fix_patch": "permissions:\n  contents: read"
                })

    return findings

def audit_sca_components(components):
    findings = []
    copyleft_licenses = {"GPL-2.0", "GPL-3.0", "AGPL-3.0", "LGPL-3.0"}
    known_vulns = {
        "log4j-core": "CVE-2021-44228",
        "commons-text": "CVE-2022-42889",
        "lodash": "CVE-2021-23337",
        "urllib3": "CVE-2023-45803"
    }

    for comp in components:
        c_name = comp.get("name", "")
        c_ver = comp.get("version", "")
        c_lic = comp.get("license")

        # Copyleft License Check
        if c_lic in copyleft_licenses:
            findings.append({
                "rule_id": "SCA_COPYLEFT_001",
                "component": c_name,
                "version": c_ver,
                "severity": "HIGH",
                "title": f"Copyleft License Detected ({c_lic})",
                "description": f"Component '{c_name}' is licensed under restrictive copyleft license '{c_lic}'."
            })

        # Known Vulnerable Package Check
        if c_name in known_vulns:
            cve = known_vulns[c_name]
            findings.append({
                "rule_id": "SCA_VULN_001",
                "component": c_name,
                "version": c_ver,
                "severity": "CRITICAL",
                "title": f"Known Vulnerable Dependency: {c_name} ({cve})",
                "description": f"Component '{c_name}' v{c_ver} is associated with {cve}."
            })

    return findings

def generate_cyclonedx_sbom(components):
    return {
        "bomFormat": "CycloneDX",
        "specVersion": "1.5",
        "serialNumber": "urn:uuid:3e671687-395b-41f5-a30f-a58921a69b79",
        "version": 1,
        "metadata": {
            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "tools": [{"vendor": "CloudSecure", "name": "CodeSecure", "version": "0.2.0"}]
        },
        "components": [
            {
                "type": "library",
                "name": c.get("name"),
                "version": c.get("version"),
                "purl": c.get("purl", f"pkg:cargo/{c.get('name')}@{c.get('version')}"),
                "licenses": [{"license": {"id": c.get("license", "MIT")}}] if c.get("license") else []
            }
            for c in components
        ]
    }

def generate_spdx_sbom(components):
    return {
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": "CloudSecure-Application-SBOM",
        "documentNamespace": "https://cloudsecure.io/spdx/doc-001",
        "creationInfo": {
            "creators": ["Tool: CodeSecure-0.2.0"],
            "created": datetime.datetime.now(datetime.timezone.utc).isoformat()
        },
        "packages": [
            {
                "SPDXID": f"SPDXRef-Package-{c.get('name')}",
                "name": c.get("name"),
                "versionInfo": c.get("version"),
                "downloadLocation": "NOASSERTION",
                "filesAnalyzed": False,
                "licenseConcluded": c.get("license", "NOASSERTION")
            }
            for c in components
        ]
    }

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if req_id is None:
            # JSON-RPC / MCP notifications do not have an ID and must not receive a response
            continue

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "codesecure-mcp", "version": "0.2.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "codesecure_scan_iac",
                            "description": "Scan Terraform, Kubernetes, Dockerfile, and GitHub Actions for misconfigurations and secrets",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"files_json": {"type": "string"}},
                                "required": ["files_json"]
                            }
                        },
                        {
                            "name": "codesecure_audit_sca",
                            "description": "Audit SBOM components for copyleft licenses and known vulnerabilities",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"components_json": {"type": "string"}},
                                "required": ["components_json"]
                            }
                        },
                        {
                            "name": "codesecure_export_sbom",
                            "description": "Export CycloneDX 1.5 or SPDX 2.3 Software Bill of Materials",
                            "inputSchema": {
                                "type": "object",
                                "properties": {
                                    "components_json": {"type": "string"},
                                    "format": {"type": "string", "enum": ["cyclonedx", "spdx"]}
                                },
                                "required": ["components_json"]
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            if name == "codesecure_scan_iac":
                raw_json = args.get("files_json", "[]")
                try:
                    files = json.loads(raw_json)
                    all_findings = []
                    for f in files:
                        all_findings.extend(scan_file(f))
                    tool_res = {"total_findings": len(all_findings), "findings": all_findings}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "codesecure_audit_sca":
                raw_json = args.get("components_json", "[]")
                try:
                    comps = json.loads(raw_json)
                    sca = audit_sca_components(comps)
                    tool_res = {"sca_findings_count": len(sca), "findings": sca}
                except Exception as e:
                    tool_res = {"error": str(e)}
            elif name == "codesecure_export_sbom":
                raw_json = args.get("components_json", "[]")
                fmt = args.get("format", "cyclonedx")
                try:
                    comps = json.loads(raw_json)
                    if fmt == "spdx":
                        tool_res = generate_spdx_sbom(comps)
                    else:
                        tool_res = generate_cyclonedx_sbom(comps)
                except Exception as e:
                    tool_res = {"error": str(e)}
            else:
                tool_res = {"error": f"Unknown tool: {name}"}

            call_result = {
                "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
            }
            if isinstance(tool_res, dict) and "error" in tool_res:
                call_result["isError"] = True
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": call_result
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="CodeSecure CLI: ASPM, IaC Scanner and SBOM Generator")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    scan_p = subparsers.add_parser("scan", help="Scan IaC bundle JSON for security issues")
    scan_p.add_argument("--input", "-i", required=True, help="Path to IaC bundle JSON")
    scan_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")

    sca_p = subparsers.add_parser("sca", help="Audit SBOM components for licenses and vulnerabilities")
    sca_p.add_argument("--input", "-i", required=True, help="Path to components JSON")

    sbom_p = subparsers.add_parser("sbom", help="Generate CycloneDX 1.5 or SPDX 2.3 SBOM")
    sbom_p.add_argument("--input", "-i", required=True, help="Path to components JSON")
    sbom_p.add_argument("--format", "-f", choices=["cyclonedx", "spdx"], default="cyclonedx")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "scan":
        with open(args.input, "r", encoding="utf-8") as f:
            files = json.load(f)
        all_findings = []
        for file_obj in files:
            all_findings.extend(scan_file(file_obj))

        if args.format == "table":
            print(f"{'SEVERITY':<10} {'RULE ID':<16} {'LINE':<6} {'FILE PATH':<28} {'TITLE'}")
            print("-" * 105)
            for f in all_findings:
                glyph = "[!]" if f["severity"] == "CRITICAL" else "[*]"
                print(f"{glyph + ' ' + f['severity']:<10} {f['rule_id']:<16} {str(f['line_number']):<6} {f['file_path']:<28} {f['title']}")
            print("-" * 105)
            print(f"Total IaC Findings: {len(all_findings)}")
        elif args.format == "json":
            print(json.dumps(all_findings, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "CodeSecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": f["rule_id"],
                        "level": "error" if f["severity"] == "CRITICAL" else "warning",
                        "message": {"text": f["title"]},
                        "locations": [{
                            "physicalLocation": {
                                "artifactLocation": {"uri": f["file_path"]},
                                "region": {"startLine": f["line_number"]}
                            }
                        }]
                    } for f in all_findings]
                }]
            }
            print(json.dumps(sarif, indent=2))

    elif args.subcommand == "sca":
        with open(args.input, "r", encoding="utf-8") as f:
            comps = json.load(f)
        sca_findings = audit_sca_components(comps)
        print(f"SCA Findings ({len(sca_findings)}):")
        for s in sca_findings:
            print(f"  [{s['severity']}] {s['rule_id']}: {s['title']} - {s['description']}")

    elif args.subcommand == "sbom":
        with open(args.input, "r", encoding="utf-8") as f:
            comps = json.load(f)
        if args.format == "spdx":
            print(json.dumps(generate_spdx_sbom(comps), indent=2))
        else:
            print(json.dumps(generate_cyclonedx_sbom(comps), indent=2))

    else:
        parser.print_help()

if __name__ == "__main__":
    main()
