#!/usr/bin/env python3
import sys, os, json, argparse, re

def action_matches(pattern, action):
    if pattern == "*":
        return True
    if pattern.endswith(":*"):
        return action.startswith(pattern[:-1])
    return pattern.lower() == action.lower()

def compute_effective_actions(principal):
    allowed = set()
    denied = set()

    for stmt in principal.get("inline_statements", []):
        is_allow = stmt.get("effect", "").lower() == "allow"
        for act in stmt.get("actions", []):
            if is_allow:
                allowed.add(act)
            else:
                denied.add(act)

    for pol in principal.get("attached_policies", []):
        if pol.lower() == "administratoraccess":
            allowed.add("*")

    effective = allowed - denied

    # If permission boundary is specified, intersect with boundary
    boundary_stmts = principal.get("permission_boundary_statements", [])
    if boundary_stmts:
        boundary_allowed = set()
        for b_stmt in boundary_stmts:
            if b_stmt.get("effect", "").lower() == "allow":
                for act in b_stmt.get("actions", []):
                    boundary_allowed.add(act)
        if "*" not in boundary_allowed:
            intersected = set()
            for b_act in boundary_allowed:
                if any(action_matches(p_act, b_act) for p_act in effective):
                    intersected.add(b_act)
            for p_act in effective:
                if any(action_matches(b_act, p_act) for b_act in boundary_allowed):
                    intersected.add(p_act)
            effective = intersected

    return sorted(list(effective))

def find_escalations(principal):
    vectors = []
    actions = compute_effective_actions(principal)
    has_act = lambda a: any(action_matches(pat, a) for pat in actions)

    # 1. iam:PassRole + ec2:RunInstances
    if has_act("iam:PassRole") and has_act("ec2:RunInstances"):
        vectors.append({
            "vector_id": "CIEM-ESC-001",
            "name": "EC2 Instance Profile Role Assumption",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:PassRole", "ec2:RunInstances"],
            "severity": "CRITICAL",
            "description": "Principal can pass privileged IAM roles to newly launched EC2 instances to exfiltrate administrative credentials."
        })

    # 2. iam:CreatePolicyVersion
    if has_act("iam:CreatePolicyVersion"):
        vectors.append({
            "vector_id": "CIEM-ESC-002",
            "name": "IAM Policy Version Injection",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:CreatePolicyVersion"],
            "severity": "CRITICAL",
            "description": "Principal can author a new policy version granting unrestricted '*/*' administrative permissions."
        })

    # 3. iam:AttachUserPolicy / iam:AttachRolePolicy / iam:AttachGroupPolicy
    if has_act("iam:AttachUserPolicy") or has_act("iam:AttachRolePolicy") or has_act("iam:AttachGroupPolicy"):
        vectors.append({
            "vector_id": "CIEM-ESC-003",
            "name": "Administrative Policy Attachment",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:AttachUserPolicy", "iam:AttachRolePolicy"],
            "severity": "CRITICAL",
            "description": "Principal can attach AdministratorAccess policy directly to identity or assumed roles."
        })

    # 4. lambda:CreateFunction + iam:PassRole
    if has_act("lambda:CreateFunction") and has_act("iam:PassRole"):
        vectors.append({
            "vector_id": "CIEM-ESC-004",
            "name": "Serverless Execution Privilege Escalation",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["lambda:CreateFunction", "iam:PassRole"],
            "severity": "CRITICAL",
            "description": "Principal can deploy a Lambda function executing under an overprivileged role."
        })

    # 5. iam:PutUserPolicy / iam:PutRolePolicy / iam:PutGroupPolicy
    if has_act("iam:PutUserPolicy") or has_act("iam:PutRolePolicy") or has_act("iam:PutGroupPolicy"):
        vectors.append({
            "vector_id": "CIEM-ESC-005",
            "name": "Inline Administrative Policy Injection",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:PutUserPolicy", "iam:PutRolePolicy"],
            "severity": "CRITICAL",
            "description": "Principal can inject inline policies containing Action=* directly into principals."
        })

    # 6. iam:CreateAccessKey
    if has_act("iam:CreateAccessKey"):
        vectors.append({
            "vector_id": "CIEM-ESC-006",
            "name": "Administrative Access Key Generation",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:CreateAccessKey"],
            "severity": "HIGH",
            "description": "Principal can generate programmatic access keys on other target users."
        })

    # 7. iam:UpdateAssumeRolePolicy
    if has_act("iam:UpdateAssumeRolePolicy"):
        vectors.append({
            "vector_id": "CIEM-ESC-007",
            "name": "AssumeRole Trust Policy Manipulation",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:UpdateAssumeRolePolicy"],
            "severity": "CRITICAL",
            "description": "Principal can rewrite the trust relationship on privileged roles to allow self-assumption."
        })

    # 8. lambda:UpdateFunctionCode
    if has_act("lambda:UpdateFunctionCode"):
        vectors.append({
            "vector_id": "CIEM-ESC-008",
            "name": "Serverless Function Code Poisoning",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["lambda:UpdateFunctionCode"],
            "severity": "HIGH",
            "description": "Principal can modify existing high-privilege Lambda code to exfiltrate function IAM tokens."
        })

    # 9. glue:CreateDevEndpoint + iam:PassRole
    if has_act("glue:CreateDevEndpoint") and has_act("iam:PassRole"):
        vectors.append({
            "vector_id": "CIEM-ESC-009",
            "name": "AWS Glue DevEndpoint Role Exploitation",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["glue:CreateDevEndpoint", "iam:PassRole"],
            "severity": "CRITICAL",
            "description": "Principal can attach an admin role to an AWS Glue DevEndpoint and access its shell credentials."
        })

    # 10. cloudformation:CreateStack + iam:PassRole
    if has_act("cloudformation:CreateStack") and has_act("iam:PassRole"):
        vectors.append({
            "vector_id": "CIEM-ESC-010",
            "name": "CloudFormation Stack Role Escalation",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["cloudformation:CreateStack", "iam:PassRole"],
            "severity": "CRITICAL",
            "description": "Principal can launch a CloudFormation stack using an administrative execution role."
        })

    # 11. iam:SetDefaultPolicyVersion
    if has_act("iam:SetDefaultPolicyVersion"):
        vectors.append({
            "vector_id": "CIEM-ESC-011",
            "name": "Rollback to Insecure Policy Version",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:SetDefaultPolicyVersion"],
            "severity": "HIGH",
            "description": "Principal can revert a customer managed policy to an older version that had star permissions."
        })

    # 12. iam:CreateLoginProfile / iam:UpdateLoginProfile
    if has_act("iam:CreateLoginProfile") or has_act("iam:UpdateLoginProfile"):
        vectors.append({
            "vector_id": "CIEM-ESC-012",
            "name": "Console Login Password Reset",
            "principal_arn": principal.get("arn", ""),
            "required_actions": ["iam:CreateLoginProfile", "iam:UpdateLoginProfile"],
            "severity": "CRITICAL",
            "description": "Principal can create or reset the AWS Management Console password of administrative users."
        })

    return vectors

def audit_trust_policy(principal):
    findings = []
    trust_doc = principal.get("assume_role_policy_document", {})
    stmts = trust_doc.get("Statement", [])

    for stmt in stmts:
        if stmt.get("Effect") != "Allow":
            continue
        principal_field = stmt.get("Principal", {})
        cond = stmt.get("Condition", {})

        # Check AWS Account trust for missing sts:ExternalId
        aws_princ = principal_field.get("AWS")
        if aws_princ:
            is_cross_account = False
            curr_acct = principal.get("arn", "").split(":")[4] if len(principal.get("arn", "").split(":")) > 4 else ""
            if isinstance(aws_princ, str) and curr_acct and curr_acct not in aws_princ:
                is_cross_account = True
            elif isinstance(aws_princ, list):
                is_cross_account = any(curr_acct and curr_acct not in p for p in aws_princ)

            has_external_id = any(
                "sts:ExternalId" in c_val for c_val in cond.values() if isinstance(c_val, dict)
            )

            if is_cross_account and not has_external_id:
                findings.append({
                    "rule_id": "CIEM-TRUST-001",
                    "severity": "HIGH",
                    "title": "Cross-Account Trust Policy Missing sts:ExternalId",
                    "description": f"Role '{principal.get('name')}' trusts external AWS account without requiring sts:ExternalId (confused deputy risk)."
                })

        # Check Federated OIDC (GitHub Actions) for missing sub condition
        fed_princ = principal_field.get("Federated")
        if fed_princ and "token.actions.githubusercontent.com" in str(fed_princ):
            has_sub = any(
                "token.actions.githubusercontent.com:sub" in c_val
                for c_val in cond.values() if isinstance(c_val, dict)
            )
            if not has_sub:
                findings.append({
                    "rule_id": "CIEM-TRUST-002",
                    "severity": "CRITICAL",
                    "title": "GitHub Actions OIDC Trust Missing Repository Subject Condition",
                    "description": f"Role '{principal.get('name')}' trusts GitHub OIDC without restricting to specific repository or branch."
                })

    return findings

def right_size_principal(principal):
    eff = compute_effective_actions(principal)
    granted_count = 120 if "*" in eff else len(eff)
    used = principal.get("observed_actions", [])
    used_count = len(used)
    unused_count = max(0, granted_count - used_count)
    gap_pct = round((unused_count / granted_count) * 100.0, 1) if granted_count > 0 else 0.0

    is_dormant = principal.get("last_active_days", 0) > 90

    safe_actions = used if used else ["sts:GetCallerIdentity"]
    policy_doc = {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "RightSizedLeastPrivilege",
                "Effect": "Allow",
                "Action": safe_actions,
                "Resource": "*"
            }
        ]
    }
    p_name = principal.get("name", "principal").lower().replace("_", "-")
    hcl = f"""# Right-sized least-privilege policy for {principal.get('name')}
resource "aws_iam_policy" "{p_name}_least_privilege" {{
  name        = "{p_name}-least-privilege"
  description = "Synthesized least privilege policy eliminating {gap_pct}% unused permissions"
  policy      = jsonencode({json.dumps(policy_doc, indent=2)})
}}"""

    return {
        "principal_arn": principal.get("arn", ""),
        "is_dormant": is_dormant,
        "last_active_days": principal.get("last_active_days", 0),
        "granted_actions_count": granted_count,
        "used_actions_count": used_count,
        "unused_actions_count": unused_count,
        "entitlement_gap_percentage": gap_pct,
        "synthesized_least_privilege_policy_json": json.dumps(policy_doc, indent=2),
        "remediation_hcl": hcl
    }

def run_mcp():
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        req_id = req.get("id")
        method = req.get("method")

        if req_id is None:
            # JSON-RPC / MCP notifications do not have an ID and must not receive a response
            continue

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "identitysecure-mcp", "version": "0.2.0"}
                }
            }
        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": [
                        {
                            "name": "ciem_evaluate_permissions",
                            "description": "Solve net-effective permissions across inline and attached IAM policies with boundaries",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"principal_json": {"type": "string"}},
                                "required": ["principal_json"]
                            }
                        },
                        {
                            "name": "ciem_detect_escalations",
                            "description": "Detect 12+ cloud IAM privilege escalation vectors on target principal",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"principal_json": {"type": "string"}},
                                "required": ["principal_json"]
                            }
                        },
                        {
                            "name": "ciem_audit_trust_policies",
                            "description": "Audit cross-account and federated OIDC trust policies for missing ExternalId or subject constraints",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"principal_json": {"type": "string"}},
                                "required": ["principal_json"]
                            }
                        },
                        {
                            "name": "ciem_right_size_principal",
                            "description": "Compare granted permissions against observed activity and synthesize least-privilege policy",
                            "inputSchema": {
                                "type": "object",
                                "properties": {"principal_json": {"type": "string"}},
                                "required": ["principal_json"]
                            }
                        }
                    ]
                }
            }
        elif method == "tools/call":
            params = req.get("params", {})
            name = params.get("name")
            args = params.get("arguments", {})
            raw_p = args.get("principal_json", "{}")
            try:
                p = json.loads(raw_p)
                if name == "ciem_evaluate_permissions":
                    acts = compute_effective_actions(p)
                    tool_res = {"principal": p.get("name"), "effective_actions_count": len(acts), "actions": acts}
                elif name == "ciem_detect_escalations":
                    escs = find_escalations(p)
                    tool_res = {"escalations_count": len(escs), "escalation_vectors": escs}
                elif name == "ciem_audit_trust_policies":
                    trust_findings = audit_trust_policy(p)
                    tool_res = {"trust_findings_count": len(trust_findings), "findings": trust_findings}
                elif name == "ciem_right_size_principal":
                    tool_res = right_size_principal(p)
                else:
                    tool_res = {"error": f"Unknown tool: {name}"}
            except Exception as e:
                tool_res = {"error": str(e)}

            call_result = {
                "content": [{"type": "text", "text": json.dumps(tool_res, indent=2)}]
            }
            if isinstance(tool_res, dict) and "error" in tool_res:
                call_result["isError"] = True
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": call_result
            }
        else:
            resp = {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found"}}

        sys.stdout.write(json.dumps(resp) + "\n")
        sys.stdout.flush()

def main():
    parser = argparse.ArgumentParser(description="IdentitySecure CLI: Cloud Infrastructure Entitlement Management")
    parser.add_argument("--mcp", action="store_true", help="Run Model Context Protocol stdio server")
    subparsers = parser.add_subparsers(dest="subcommand")

    esc_p = subparsers.add_parser("escalations", help="Scan principals for privilege escalation vectors")
    esc_p.add_argument("--input", "-i", required=True, help="Path to IAM directory JSON")
    esc_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")

    right_p = subparsers.add_parser("right-size", help="Compute entitlement gap and synthesize least-privilege policy")
    right_p.add_argument("--input", "-i", required=True, help="Path to IAM directory JSON")
    right_p.add_argument("--principal", "-p", help="Target principal name (default: all)")
    right_p.add_argument("--format", "-f", choices=["table", "json"], default="table")

    trust_p = subparsers.add_parser("trust-audit", help="Audit trust policies for cross-account and OIDC vulnerabilities")
    trust_p.add_argument("--input", "-i", required=True, help="Path to IAM directory JSON")
    trust_p.add_argument("--format", "-f", choices=["table", "json", "sarif"], default="table")

    args = parser.parse_args()
    if args.mcp:
        run_mcp()
        return

    if args.subcommand == "escalations":
        with open(args.input, "r", encoding="utf-8") as f:
            principals = json.load(f)
        all_escs = []
        for p in principals:
            escs = find_escalations(p)
            all_escs.extend(escs)
        if args.format == "json":
            print(json.dumps(all_escs, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "IdentitySecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": e["vector_id"],
                        "level": "error" if e["severity"] == "CRITICAL" else "warning",
                        "message": {"text": f"{e['name']}: {e['description']}"},
                        "locations": [{
                            "physicalLocation": {
                                "artifactLocation": {"uri": e.get("principal_arn", "")}
                            }
                        }]
                    } for e in all_escs]
                }]
            }
            print(json.dumps(sarif, indent=2))
        else:
            print(f"Privilege Escalation Vectors Detected ({len(all_escs)}):")
            for e in all_escs:
                print(f"  [{e['severity']}] {e['vector_id']}: {e['name']} ({e['principal_arn']})")

    elif args.subcommand == "right-size":
        with open(args.input, "r", encoding="utf-8") as f:
            principals = json.load(f)
        targets = [p for p in principals if not args.principal or p.get("name") == args.principal]
        if args.format == "json":
            reports = [right_size_principal(t) for t in targets]
            print(json.dumps(reports, indent=2))
        else:
            for t in targets:
                rep = right_size_principal(t)
                dormant_str = " [DORMANT > 90d]" if rep["is_dormant"] else ""
                print(f"\nPrincipal: {t.get('name')} ({t.get('arn')}){dormant_str}")
                print(f"  Granted: {rep['granted_actions_count']} | Observed: {rep['used_actions_count']} | Entitlement Gap: {rep['entitlement_gap_percentage']}%")
                print(f"  Synthesized Remediation HCL:\n{rep['remediation_hcl']}")

    elif args.subcommand == "trust-audit":
        with open(args.input, "r", encoding="utf-8") as f:
            principals = json.load(f)
        all_findings = []
        for p in principals:
            all_findings.extend(audit_trust_policy(p))
        if args.format == "json":
            print(json.dumps(all_findings, indent=2))
        elif args.format == "sarif":
            sarif = {
                "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
                "version": "2.1.0",
                "runs": [{
                    "tool": {"driver": {"name": "IdentitySecure", "version": "0.2.0"}},
                    "results": [{
                        "ruleId": tf["rule_id"],
                        "level": "error" if tf["severity"] == "CRITICAL" else "warning",
                        "message": {"text": f"{tf['title']}: {tf['description']}"}
                    } for tf in all_findings]
                }]
            }
            print(json.dumps(sarif, indent=2))
        else:
            print(f"Trust Policy Findings ({len(all_findings)}):")
            for tf in all_findings:
                print(f"  [{tf['severity']}] {tf['rule_id']}: {tf['title']} - {tf['description']}")

    else:
        parser.print_help()

if __name__ == "__main__":
    main()
